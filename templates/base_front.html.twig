<!DOCTYPE html>
<html lang="fr" data-theme="lofi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {# Jeton CSRF de la saisie des scores (score-modal-controller.js, vérifié par FrontController::api_score_update).
       Seulement pour les utilisateurs connectés : inutile de créer une session pour les visiteurs. #}
    {% if app.user %}<meta name="csrf-token" content="{{ csrf_token('score_update') }}">{% endif %}
    <title>{% block title %}BLVB{% endblock %}</title>

    <link rel="icon" href="{{ asset('images/favicon.svg') }}" type="image/svg+xml">
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% endblock %}
    {% block javascripts %}
        {{ importmap('app') }}
    {% endblock %}
</head>
<body class="bg-base-100 text-base-content" data-controller="mon-equipe" data-mon-equipe-defaut-value="{{ (mon_equipe_defaut() ?? {'id': null})|json_encode }}">

<div class="drawer drawer-mobile">
    <input id="my-drawer-2" type="checkbox" class="drawer-toggle" />

    {# Contenu principal #}
    <div class="drawer-content flex flex-col min-h-screen">

        {# Navbar #}
        <header class="navbar bg-primary text-primary-content shadow-md sticky top-0 z-50">
            <div class="flex-none lg:hidden">
                <label for="my-drawer-2" aria-label="Ouvrir le menu" class="btn btn-square btn-ghost">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block h-6 w-6 stroke-current">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                    </svg>
                </label>
            </div>

            <div class="flex flex-1 px-2 mx-2 font-bold text-lg items-center">
                <a class="mr-3" href="{{ path('front_index') }}">{% include 'front/fragments/_logo.html.twig' %}</a>
                {# Sélecteur de saison absent sur les pages qui ne le fournissent pas (connexion, mot de passe…) #}
                {% if saisons is defined %}
                {# Sur mobile, le sélecteur de saison (rarement utilisé) est dans le menu latéral #}
                <div class="hidden lg:block">
                    <form method="post" action="{{ path('front_set_saison') }}">
                    <select name="idSaisonSelected" aria-label="Saison" class="select select-sm w-auto text-base-content" onchange="this.form.submit()">
                        {% for saison in saisons %}
                            <option value="{{ saison.id }}" {% if saison.id == idSaisonSelected %}selected{% endif %}>
                                {{ saison.nom }}
                            </option>
                        {% endfor %}
                    </select>
                    </form>
                </div>
                {% endif %}
            </div>

            {# Menu desktop #}
            <div class="hidden lg:flex flex-none items-center">
                <ul class="menu menu-horizontal px-1">
                    {% block navbar_links %}
                        <li><a href="{{ path('front_index') }}">Accueil</a></li>
                        {# Lien vers l'équipe suivie, affiché par mon_equipe_controller.js #}
                        <li class="hidden" data-mon-equipe-target="menu"><a href="#">Mon équipe</a></li>
                        <li data-mon-equipe-target="menuChoisir"><a href="#" data-action="mon-equipe#ouvrirChoix">☆ Choisir mon équipe</a></li>
                        <li><a href="{{ path('front_equipes')}}">Les équipes</a></li>

                        <li><a href="{{ path('front_classement')}}">Classement</a></li>


                        <li>
                            <details>
                                <summary>Calendrier</summary>
                                <ul class="bg-base-100 text-base-content rounded-t-none p-2 z-[100] w-52 shadow-lg">
                                    <li><a href="{{ path('front_calendrier')}}">Par équipe</a></li>
                                    <li><a href="{{ path('front_calendrierlieu')}}">Par gymnase</a></li>
                                </ul>
                            </details>
                        </li>

                        <li>
                            <details>
                                <summary>Le championnat</summary>
                                <ul class="bg-base-100 text-base-content rounded-t-none p-2 z-[100] w-52 shadow-lg">
                                    <li><a href="{{ path('front_qui_sommes_nous')}}">Qui sommes-nous ?</a></li>
                                    <li><a href="{{ path('front_reglement')}}">Règlement</a></li>
                                </ul>
                            </details>
                        </li>
                        {% if app.user %}
                            {% if is_granted('ROLE_ADMIN') %}
                                <li><a href="{{path('app_admin_dashboard')}}">Administration</a></li>
                            {% endif %}
                            <div class="dropdown dropdown-end">
                                {# Le déclencheur doit avoir tabindex="0" pour être cliquable #}
                                <div tabindex="0" role="button" class="btn btn-ghost rounded-full flex items-center px-2 gap-1">

                                        {# Icône User Pleine et centrée #}
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                                            <path fill-rule="evenodd" d="M7.5 6a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0ZM3.751 20.105a8.25 8.25 0 0 1 16.498 0 .75.75 0 0 1-.437.695A18.683 18.683 0 0 1 12 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 0 1-.437-.695Z" clip-rule="evenodd" />
                                        </svg>
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="size-3 opacity-60">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                                        </svg>

                                </div>

                                {# Le menu s'affiche grâce au focus sur le déclencheur ci-dessus #}
                                <ul tabindex="-1" class="menu menu-sm dropdown-content bg-base-100 text-base-content rounded-box z-[100] mt-3 w-52 p-2 shadow-2xl border border-base-300">
                                    <li class="menu-title px-4 py-2 opacity-60">
                                        {{ app.user.prenom|capitalize }} {{ app.user.nom|upper }}
                                    </li>

                                    <div class="divider my-0"></div>

                                    <li>
                                        <a href="{{ path('front_profile_edit') }}" class="py-3">
                                            Mon Profil
                                        </a>
                                    </li>

                                    <li>
                                        {# Déconnexion via formulaire POST pour Turbo #}
                                        <form action="{{ path('app_logout') }}" method="POST" class="p-0 w-full">
                                            <button type="submit" class="flex items-center w-full px-3 py-2 text-error hover:bg-error/10 transition-colors rounded-lg">
                                                Se déconnecter
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                            {% else %}
                            <li>
                                <a href="{{path('app_login')}}" class="btn btn-accent btn-sm ml-2">Se connecter</a>
                            </li>
                        {% endif %}
                    {% endblock %}
                </ul>
            </div>
        </header>

        {# Contenu de la page avec container central sur desktop #}
        {% block hero %}{% endblock %}
        <main class="flex-1 p-4">


                {% block body %}{% endblock %}

        </main>
    </div>

    {# Sidebar #}
    <div class="drawer-side z-[60]">
        <label for="my-drawer-2" aria-label="Fermer le menu" class="drawer-overlay"></label>
        <aside class="menu p-4 w-64 bg-base-200 min-h-full">
            {% block sidebar_links %}
                <li><a href="{{ path('front_index') }}">Accueil</a></li>
                <li class="hidden" data-mon-equipe-target="menu"><a href="#">Mon équipe</a></li>
                <li data-mon-equipe-target="menuChoisir"><a href="#" data-action="mon-equipe#ouvrirChoix">☆ Choisir mon équipe</a></li>
                <li><a href="{{ path('front_equipes')}}">Les équipes</a></li>
                <li tabindex="0">
                    <a class="justify-between">Calendrier
                        <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M19 9l-7 7-7-7" />
                        </svg>
                    </a>
                    <ul class="p-2 bg-base-100">
                        <li><a href="{{ path('front_calendrier')}}">Par équipe</a></li>
                        <li><a href="{{ path('front_calendrierlieu')}}">Par gymnase</a></li>
                    </ul>
                </li>
                <li><a href="{{ path('front_classement')}}">Classement</a></li>
                <li tabindex="0">
                    <a class="justify-between">Le championnat
                        <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M19 9l-7 7-7-7" />
                        </svg>
                    </a>
                    <ul class="p-2 bg-base-100">
                        <li><a href="{{ path('front_qui_sommes_nous')}}">Qui sommes-nous ?</a></li>
                        <li><a href="{{ path('front_reglement')}}">Règlement</a></li>
                    </ul>
                </li>

                {% if app.user %}
                    {% if is_granted('ROLE_ADMIN') %}
                        <li><a href="{{path('app_admin_dashboard')}}">Administration</a></li>
                {% endif %}
                    <li>
                        <form method="post" action="{{ path('app_logout') }}" class="inline-flex items-center">
                            <button type="submit" class="">Se déconnecter</button>
                        </form>
                    </li>
                {% else %}
{#                <li><a href="{{path('app_register')}}">Créer un compte</a></li>#}
                <li><a href="{{path('app_login')}}">Se connecter</a></li>
                {% endif %}
            {% endblock %}
            {% if saisons is defined %}
                <li class="menu-title mt-4">Saison</li>
                <li class="px-2">
                    <form method="post" action="{{ path('front_set_saison') }}" class="p-0 bg-transparent">
                        <select name="idSaisonSelected" aria-label="Saison" class="select w-full text-base" onchange="this.form.submit()">
                            {% for saison in saisons %}
                                <option value="{{ saison.id }}" {% if saison.id == idSaisonSelected %}selected{% endif %}>{{ saison.nom }}</option>
                            {% endfor %}
                        </select>
                    </form>
                </li>
            {% endif %}
        </aside>
    </div>

</div>
{%  include "front/fragments/_footer.html.twig" %}
{% block extra_scripts %}{% endblock %}
{# « Mon équipe » : fenêtre de choix (ouverte depuis le menu) et message de confirmation #}
<dialog class="modal" data-mon-equipe-target="dialogue" aria-labelledby="titre-choisir-mon-equipe">
    <div class="modal-box flex flex-col gap-3">
        <h2 id="titre-choisir-mon-equipe" class="text-xl uppercase tracking-wide">Choisir mon équipe</h2>
        <p>Sa poule s'ouvrira directement sur l'accueil, le calendrier, les équipes et le classement, et ses matchs seront surlignés. Ce choix reste dans votre navigateur.</p>
        {% include 'front/fragments/_choisir_mon_equipe.html.twig' with {idSelect: 'mon-equipe-dialogue'} %}
        <div class="modal-action mt-0">
            <form method="dialog"><button class="btn btn-ghost">Annuler</button></form>
        </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button>Fermer</button></form>
</dialog>
<div role="status" aria-live="polite">
    <div class="hidden" data-mon-equipe-target="confirmation">
        <div class="toast toast-end toast-bottom z-[100]">
            <div class="alert bg-primary text-primary-content border-0 shadow-lg max-w-sm whitespace-normal"><span data-mon-equipe-target="confirmationTexte"></span></div>
        </div>
    </div>
</div>
</body>
</html>
