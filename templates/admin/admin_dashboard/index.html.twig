{% extends 'base_admin.html.twig' %}
{% import 'admin/_icones.html.twig' as icone %}

{% block title %}Tableau de bord{% endblock %}

{% block body %}
    {{ include('admin/_entete.html.twig', {titre: 'Tableau de bord'}) }}

    {% set saison = admin_saison_courante() %}
    {% if saison %}
        <section class="admin-carte mb-6 flex flex-wrap items-center justify-between gap-4 border-l-4 border-l-(--color-accent)">
            <div>
                <p class="text-sm font-semibold uppercase tracking-wider text-(--color-base-content)/80">{{ saison.favori ? 'Saison affichée sur le site' : 'Saison la plus récente' }}</p>
                <h2 class="text-2xl text-(--color-primary)">{{ saison.nom }}</h2>
                <p class="text-sm text-(--color-base-content)/80">{{ saison.phases|length }} phase{{ saison.phases|length > 1 ? 's' : '' }} : c'est depuis la page de la saison que se gèrent les phases, les poules, les journées et les matchs.</p>
            </div>
            <div class="flex flex-wrap gap-2">
                <a class="btn btn-ghost btn-sm" href="{{ path('admin_saison_index') }}">Toutes les saisons</a>
                <a class="btn btn-primary" href="{{ path('admin_saison_show', {id: saison.id}) }}">Piloter la saison</a>
            </div>
        </section>
    {% endif %}

    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        {% for tuile in [
            {route: 'admin_equipe_index', titre: 'Équipes', nombre: nombres.equipes, texte: 'Créer, modifier, gérer la composition', icone: 'equipes'},
            {route: 'admin_joueur_index', titre: 'Joueurs', nombre: nombres.joueurs, texte: 'Fiches joueurs et coordonnées', icone: 'joueur'},
            {route: 'admin_user_index', titre: 'Utilisateurs', nombre: nombres.utilisateurs, texte: 'Comptes de connexion, import Excel', icone: 'compte'},
            {route: 'admin_lieu_index', titre: 'Gymnases', nombre: nombres.gymnases, texte: 'Adresses et créneaux', icone: 'gymnase'},
        ] %}
            <a href="{{ path(tuile.route) }}" class="admin-carte group flex items-start gap-3 no-underline transition-colors hover:border-(--color-primary)">
                <span class="rounded-field bg-(--color-primary)/10 p-2 text-(--color-primary)">{{ icone.i(tuile.icone, 'size-6') }}</span>
                <span class="min-w-0">
                    <span class="flex items-baseline gap-2">
                        <span class="font-display text-xl font-semibold group-hover:underline">{{ tuile.titre }}</span>
                        <span class="text-sm text-(--color-base-content)/80 tabular-nums">{{ tuile.nombre }}</span>
                    </span>
                    <span class="block text-sm text-(--color-base-content)/80">{{ tuile.texte }}</span>
                </span>
            </a>
        {% endfor %}
    </div>

    <p class="mt-8 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-(--color-base-content)/80">
        <span class="inline-flex items-center gap-1">{{ icone.i('outils') }} Outils techniques :</span>
        <a class="hover:underline" href="{{ path('admin_phase_index') }}">Phases</a>
        <a class="hover:underline" href="{{ path('admin_poule_index') }}">Poules</a>
        <a class="hover:underline" href="{{ path('admin_journee_index') }}">Journées</a>
        <a class="hover:underline" href="{{ path('admin_partie_index') }}">Matchs</a>
    </p>
{% endblock %}
