{% extends 'base_admin.html.twig' %}
{% import 'admin/_icones.html.twig' as icone %}

{% block title %}Journées{% endblock %}

{% block body %}
    {{ include('admin/_entete.html.twig', {
        titre: 'Journées',
        sous_titre: 'Outil technique : les journées se créent et se placent depuis la page de chaque saison.',
        actions: [{url: path('admin_journee_new'), label: 'Créer une journée', icone: 'plus', principal: true}],
    }) }}
    <div class="admin-carte" data-controller="datatable" data-datatable-per-page-value="0" data-datatable-singulier-value="journée" data-datatable-pluriel-value="journées">
        <div class="mb-3 flex flex-wrap items-center gap-3">
            <label class="input input-sm w-full max-w-xs">
                <span class="sr-only">Rechercher une journée</span>
                <input type="search" placeholder="Rechercher…" data-datatable-target="search" data-action="input->datatable#filter">
            </label>
            <p class="text-sm text-(--color-base-content)/80" data-datatable-target="compteur" aria-live="polite"></p>
        </div>
        <div class="max-lg:overflow-x-auto">
            <table class="table table-admin">
                <thead>
                <tr><th>Journée</th><th>Poule</th><th>Du</th><th>Au</th><th data-datatable-no-sort><span class="sr-only">Actions</span></th></tr>
                </thead>
                <tbody data-datatable-target="body">
                {% for journee in journees %}
                    <tr>
                        <td><a class="font-semibold text-(--color-primary) hover:underline" href="{{ path('admin_journee_edit', {id: journee.id}) }}">Journée {{ journee.numero }}</a></td>
                        <td>{{ journee.poule ? journee.poule.phase.saison.nom ~ ' · ' ~ journee.poule.phase.nom ~ ' · ' ~ journee.poule.nom }}</td>
                        <td>{{ journee.dateDebut ? journee.dateDebut|date('d/m/Y') }}</td>
                        <td>{{ journee.dateFin ? journee.dateFin|date('d/m/Y') }}</td>
                        <td class="text-right"><a class="btn btn-ghost btn-sm" href="{{ path('admin_journee_edit', {id: journee.id}) }}" aria-label="Modifier la journée {{ journee.numero }}">{{ icone.i('crayon') }} Modifier</a></td>
                    </tr>
                {% else %}
                    <tr><td colspan="5">Aucune journée.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
