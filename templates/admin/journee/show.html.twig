{% extends 'base_admin.html.twig' %}

{% block title %}Journée {{ journee.numero }}{% endblock %}

{% block body %}
    {{ include('admin/_entete.html.twig', {
        titre: 'Journée ' ~ journee.numero,
        sous_titre: (journee.dateDebut ? 'Du ' ~ journee.dateDebut|date('d/m/Y') : '') ~ (journee.dateFin ? ' au ' ~ journee.dateFin|date('d/m/Y') : ''),
        retour: {url: path('admin_journee_index'), label: 'Journées'},
        actions: [{url: path('admin_journee_edit', {id: journee.id}), label: 'Modifier', icone: 'crayon', principal: true}],
    }) }}
{% endblock %}
