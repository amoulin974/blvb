{% extends 'base_admin.html.twig' %}
{% import 'admin/_icones.html.twig' as icone %}

{% block title %}{{ saison.nom }}{% endblock %}

{# Poste de pilotage d'une saison : phases (repliables) > poules (onglets) > journées > matchs.
   À chaque niveau : actions courantes en boutons discrets ; la prochaine étape à faire (créer les journées,
   générer les matchs, clôturer la phase) en jaune ; suppressions en rouge discret, confirmées dans une fenêtre. #}
{% block body %}
    {{ include('admin/_entete.html.twig', {
        titre: saison.nom,
        sous_titre: saison.favori ? 'Saison affichée sur le site' : 'Saison non affichée sur le site',
        retour: {url: path('admin_saison_index'), label: 'Saisons'},
        actions: [{url: path('admin_saison_edit', {id: saison.id}), label: 'Modifier la saison', icone: 'crayon'}],
    }) }}

    <div class="space-y-4">
        {% for phase in saison.phases %}
            {% set nbMatchsPhase = 0 %}{% for poule in phase.poules %}{% set nbMatchsPhase = nbMatchsPhase + poule.parties|length %}{% endfor %}
            <div id="phase_{{ phase.id }}" class="collapse collapse-arrow bg-base-100 border border-base-300">
                <input type="checkbox" aria-label="Afficher ou masquer {{ phase.nom }}" {% if phase.id == phaseOuverteId %}checked{% endif %}>
                <div class="collapse-title flex flex-wrap items-baseline gap-x-3 gap-y-1">
                    <span class="font-display text-xl font-semibold">{{ phase.nom }}</span>
                    {% if phase.close %}<span class="badge badge-neutral badge-sm">Clôturée</span>{% endif %}
                    <span class="text-sm text-(--color-base-content)/80">
                        {{ phase.datedebut ? 'Du ' ~ phase.datedebut|date('d/m/Y') }}{{ phase.datefin ? ' au ' ~ phase.datefin|date('d/m/Y') }}
                        · {{ phase.poules|length }} poule{{ phase.poules|length > 1 ? 's' : '' }} · {{ nbMatchsPhase }} match{{ nbMatchsPhase > 1 ? 's' : '' }}
                    </span>
                </div>
                <div class="collapse-content">
                    {# Actions de la phase #}
                    <div class="flex flex-wrap items-center gap-2 mb-4">
                        {% if not loop.last and phase.cloturable == true and not phase.close %}
                            {{ include('admin/_confirmation.html.twig', {
                                declencheur: 'Clôturer la phase',
                                declencheur_icone: false,
                                declencheur_classe: 'btn btn-accent btn-sm',
                                titre: 'Clôturer ' ~ phase.nom ~ ' ?',
                                consequences: [
                                    'Le classement final de chaque poule est figé et la phase est marquée « Clôturée ».',
                                    'Les équipes sont réparties dans les poules de la phase suivante selon leur classement (montées et descentes).',
                                    'Les journées et les matchs de la phase suivante sont générés automatiquement.',
                                ],
                                bouton: 'Clôturer la phase',
                                ton: 'warning',
                                action: path('admin_phase_cloturer', {id: phase.id}),
                                token: csrf_token('cloturer' ~ phase.id),
                            }) }}
                        {% endif %}
                        <a class="btn btn-ghost btn-sm" href="{{ path('admin_phase_edit', {id: phase.id}) }}">{{ icone.i('crayon') }} Modifier la phase</a>
                        <a class="btn btn-ghost btn-sm" href="{{ path('admin_phase_optimiser', {id: phase.id}) }}">{{ icone.i('eclair') }} Optimiser les matchs</a>
                        <span class="ml-auto">{{ include('admin/phase/_delete_form.html.twig', {declencheur_classe: 'btn btn-ghost btn-sm text-error'}) }}</span>
                    </div>

                    {# Poules de la phase, en onglets #}
                    <div class="tabs tabs-lift">
                        {% for poule in phase.poules %}
                            <input type="radio" name="tabs_admin_{{ phase.id }}" class="tab font-display text-base" aria-label="{{ poule.nom }}"
                                   {% if (pouleOuverteId and poule.id == pouleOuverteId) or (not pouleOuverteId and loop.first) %}checked{% endif %}>
                            <div id="poule_{{ poule.id }}" class="tab-content bg-base-100 border-base-300 p-4 lg:p-6">
                                {% set aDesEquipes = poule.equipes|length > 0 %}
                                {% set aDesJournees = poule.journees|length > 0 %}
                                {% set aDesMatchs = poule.parties|length > 0 %}

                                {# Actions de la poule : la prochaine étape en jaune #}
                                <div class="flex flex-wrap items-center gap-2 mb-5">
                                    {% if aDesEquipes and not aDesJournees %}
                                        <form action="{{ path('admin_journee_createjournee', {id: poule.id}) }}" method="post">
                                            <button type="submit" class="btn btn-accent btn-sm">Créer les journées</button>
                                        </form>
                                    {% elseif aDesEquipes and aDesJournees and not aDesMatchs %}
                                        <form action="{{ path('admin_partie_optimiser', {id: poule.id}) }}" method="post">
                                            <input type="hidden" name="_token" value="{{ csrf_token('optimiser' ~ poule.id) }}">
                                            <button type="submit" class="btn btn-accent btn-sm">Générer les matchs</button>
                                        </form>
                                    {% endif %}
                                    <a class="btn btn-ghost btn-sm" href="{{ path('admin_poule_edit', {id: poule.id, origin: 'saison_show'}) }}">{{ icone.i('crayon') }} Modifier la poule</a>
                                    {% if aDesEquipes and aDesJournees %}
                                        <a class="btn btn-ghost btn-sm" href="{{ path('admin_journee_getjourneecalendar', {id: poule.id}) }}">{{ icone.i('calendrier') }} Calendrier des journées</a>
                                    {% endif %}
                                    {% if aDesMatchs %}
                                        {% set premiereJournee = poule.journees|sort((a, b) => a.numero <=> b.numero)|first %}
                                        <a class="btn btn-ghost btn-sm" href="{{ path('admin_partie_getpartiecalendar', {id: poule.id, journee: premiereJournee.id}) }}">{{ icone.i('calendrier') }} Calendrier des matchs</a>
                                    {% endif %}
                                    <span class="ml-auto flex flex-wrap gap-1">
                                        {% if aDesMatchs %}
                                            {{ include('admin/_confirmation.html.twig', {
                                                declencheur: 'Supprimer les matchs',
                                                titre: 'Supprimer tous les matchs de la poule ' ~ poule.nom ~ ' ?',
                                                consequences: [poule.parties|length ~ ' match(s) et leurs scores seront supprimés.', 'Les journées et les équipes sont conservées.'],
                                                action: path('admin_partie_deleteall', {id: poule.id}),
                                                token: csrf_token('deleteallparties' ~ poule.id),
                                            }) }}
                                        {% endif %}
                                        {% if aDesJournees %}
                                            {{ include('admin/_confirmation.html.twig', {
                                                declencheur: 'Supprimer les journées',
                                                titre: 'Supprimer toutes les journées de la poule ' ~ poule.nom ~ ' ?',
                                                consequences: [poule.journees|length ~ ' journée(s) seront supprimées' ~ (aDesMatchs ? ', avec leurs ' ~ poule.parties|length ~ ' match(s) et leurs scores.' : '.'), 'Les équipes sont conservées.'],
                                                action: path('admin_journee_deleteall', {id: poule.id}),
                                                token: csrf_token('deleteall' ~ poule.id),
                                            }) }}
                                        {% endif %}
                                        {{ include('admin/poule/_delete_form.html.twig', {declencheur_classe: 'btn btn-ghost btn-sm text-error'}) }}
                                    </span>
                                </div>

                                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                                    <section>
                                        <h3 class="text-base uppercase tracking-wider text-(--color-base-content)/80 border-b-2 border-(--color-primary) pb-1 mb-2">Équipes ({{ poule.equipes|length }})</h3>
                                        <ul class="space-y-1">
                                            {% for equipe in poule.equipes %}
                                                <li><a class="font-display font-medium tracking-wide hover:underline" href="{{ path('admin_equipe_show', {id: equipe.id}) }}">{{ equipe.nom }}</a></li>
                                            {% else %}
                                                <li class="text-(--color-base-content)/80">Aucune équipe : ajoutez-en depuis « Modifier la poule ».</li>
                                            {% endfor %}
                                        </ul>
                                    </section>

                                    <section class="lg:col-span-2">
                                        <h3 class="text-base uppercase tracking-wider text-(--color-base-content)/80 border-b-2 border-(--color-primary) pb-1 mb-2">Journées ({{ poule.journees|length }})</h3>
                                        <div class="space-y-4">
                                            {% for journee in poule.journees %}
                                                <div>
                                                    <div class="flex flex-wrap items-center justify-between gap-2">
                                                        <p class="font-display text-lg font-semibold">
                                                            Journée {{ journee.numero }}{{ journee.nom ? ' · ' ~ journee.nom }}
                                                            <span class="font-sans text-sm font-normal text-(--color-base-content)/80">du {{ journee.datedebut|date('d/m/Y') }} au {{ journee.datefin|date('d/m/Y') }}</span>
                                                        </p>
                                                        {% if journee.parties|length > 0 %}
                                                            <span class="flex items-center gap-1">
                                                                <a class="btn btn-ghost btn-xs" href="{{ path('admin_partie_getpartiecalendar', {id: poule.id, journee: journee.id}) }}">{{ icone.i('calendrier') }} Calendrier</a>
                                                                {{ include('admin/_confirmation.html.twig', {
                                                                    declencheur: 'Supprimer les matchs',
                                                                    declencheur_classe: 'btn btn-ghost btn-xs text-error',
                                                                    titre: 'Supprimer les matchs de la journée ' ~ journee.numero ~ ' (poule ' ~ poule.nom ~ ') ?',
                                                                    consequences: [journee.parties|length ~ ' match(s) et leurs scores seront supprimés.', 'La journée est conservée.'],
                                                                    action: path('admin_partie_deleteallbyjournee', {id: poule.id, journee: journee.id}),
                                                                    token: csrf_token('deleteallbyjournee' ~ journee.id),
                                                                }) }}
                                                            </span>
                                                        {% endif %}
                                                    </div>
                                                    <ul class="mt-1 divide-y divide-base-200">
                                                        {% for partie in journee.parties %}
                                                            <li class="flex items-center gap-3 py-1.5">
                                                                <span class="flex-1 min-w-0">
                                                                    <span class="font-display font-medium tracking-wide">{{ partie.nomReception }}</span>
                                                                    <span class="text-(--color-base-content)/70">contre</span>
                                                                    <span class="font-display font-medium tracking-wide">{{ partie.nomDeplacement }}</span>
                                                                    <span class="block text-xs text-(--color-base-content)/80">{{ partie.date ? partie.date|format_datetime(pattern='EEE d MMM · HH:mm', locale='fr') : 'Date à définir' }}{{ partie.lieu ? ' · ' ~ partie.lieu.nom }}</span>
                                                                </span>
                                                                <span class="font-display text-lg font-bold tabular-nums w-12 text-center">
                                                                    {%- if partie.nbSetGagnantReception is not null -%}
                                                                        {{ partie.nbSetGagnantReception|sets }}–{{ partie.nbSetGagnantDeplacement|sets }}{% if forfait_de(partie) %}<span class="sr-only"> (forfait de {{ forfait_de(partie).nom }})</span>{% endif %}
                                                                    {%- else -%}
                                                                        <span class="opacity-50" aria-label="Pas de score">–</span>
                                                                    {%- endif -%}
                                                                </span>
                                                                <a href="{{ path('admin_partie_getpartiecalendar', {id: poule.id, journee: journee.id, editPartie: partie.id}) }}"
                                                                   class="btn btn-ghost btn-sm btn-square" title="Changer la date ou le gymnase" aria-label="Changer la date ou le gymnase de {{ partie.nomReception }} contre {{ partie.nomDeplacement }}">{{ icone.i('calendrier') }}</a>
                                                                {{ include('admin/partie/_delete_form.html.twig', {declencheur_classe: 'btn btn-ghost btn-sm btn-square text-error', icone_seule: true}) }}
                                                            </li>
                                                        {% else %}
                                                            <li class="py-1.5 text-(--color-base-content)/80">Aucun match planifié.</li>
                                                        {% endfor %}
                                                    </ul>
                                                </div>
                                            {% else %}
                                                <p class="text-(--color-base-content)/80">Aucune journée créée.</p>
                                            {% endfor %}
                                        </div>
                                    </section>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        {% else %}
            <p class="admin-carte">Cette saison n'a pas encore de phase.</p>
        {% endfor %}
    </div>
{% endblock %}
