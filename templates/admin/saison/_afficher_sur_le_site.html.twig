{# Bouton « Afficher sur le site » d'une saison validée, avec la fenêtre de confirmation qui dit ce qui change.
   Variables : saison ; classe (facultatif) ; retour (facultatif, 'tableau_de_bord' pour y revenir après). #}
{{ include('admin/_confirmation.html.twig', {
    action: path('admin_saison_favorite', {id: saison.id}),
    token: csrf_token('favorite' ~ saison.id),
    titre: 'Afficher « ' ~ saison.nom ~ ' » sur le site ?',
    consequences: [
        'Les visiteurs verront cette saison en arrivant sur le site.',
        'Les motifs et les auteurs des fermetures de gymnase déjà terminées seront définitivement effacés. Les dates restent : le calendrier affichera toujours « Gymnase fermé ».',
        'La fiche du club et les fermetures de gymnase ne seront modifiables que par les responsables désignés pour cette saison. Désignez-les ensuite dans chaque club. Les scores ne changent pas : chacun garde la saisie des saisons pour lesquelles il est désigné.',
        'Les rappels de score ne concerneront plus que les matchs de cette saison.',
    ],
    bouton: 'Afficher sur le site',
    ton: 'warning',
    irreversible: false,
    champs: retour|default(false) ? {retour: retour} : {},
    declencheur: 'Afficher sur le site',
    declencheur_sr: saison.nom,
    declencheur_classe: classe|default('btn btn-ghost btn-sm'),
    declencheur_icone: false,
}) }}
