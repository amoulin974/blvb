{# Suppression d'une saison (page de modification). Impossible pour la saison affichée sur le site. #}
{% set nbPoules = 0 %}{% set nbMatchs = 0 %}
{% for phase in saison.phases %}{% for poule in phase.poules %}{% set nbPoules = nbPoules + 1 %}{% set nbMatchs = nbMatchs + poule.parties|length %}{% endfor %}{% endfor %}
{{ include('admin/_zone_suppression.html.twig', {
    resume: 'Supprime la saison et tout son contenu : phases, poules, journées, matchs et compositions.',
    titre: 'Supprimer la saison ' ~ saison.nom ~ ' ?',
    action: path('admin_saison_delete', {id: saison.id}),
    token: csrf_token('delete' ~ saison.id),
    consequences: [
        saison.phases|length ~ ' phase(s), ' ~ nbPoules ~ ' poule(s) et ' ~ nbMatchs ~ ' match(s) avec leurs scores seront supprimés.',
        'Les compositions d\'équipe de cette saison seront supprimées (les équipes et les fiches joueurs sont conservées).',
    ],
    blocage: saison.favori ? "C'est la saison affichée sur le site. Affichez d'abord une autre saison (liste des saisons, « Afficher sur le site »)." : null,
}) }}
