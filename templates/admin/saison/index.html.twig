{% extends 'base_admin.html.twig' %}
{% import 'admin/_icones.html.twig' as icone %}

{% block title %}Saisons{% endblock %}

{% block body %}
    {{ include('admin/_entete.html.twig', {
        titre: 'Saisons',
        sous_titre: 'Une seule saison est affichée sur le site public ; les autres restent consultables par les visiteurs dans le sélecteur de saison.',
        actions: [{url: path('admin_saison_wizard_nouvelle'), label: 'Créer une saison', icone: 'plus', principal: true}],
    }) }}
    <div class="admin-carte">
        <table class="table table-admin table-empilee">
            <thead>
            <tr>
                <th>Saison</th>
                <th>Sur le site</th>
                <th><span class="sr-only">Actions</span></th>
            </tr>
            </thead>
            <tbody>
            {% for saison in saisons %}
                <tr>
                    <td class="pleine-largeur"><a class="block py-3 md:inline md:py-0 font-display text-lg font-semibold tracking-wide text-(--color-primary) hover:underline" href="{{ path('admin_saison_show', {id: saison.id}) }}">{{ saison.nom }}</a></td>
                    <td class="pleine-largeur"{% if saison.brouillon or saison.favori %} data-label="Sur le site"{% endif %}>
                        {% if saison.brouillon %}
                            <span class="badge badge-outline">Brouillon · étape {{ saison.etapeWizard|default(2) }} sur 6</span>
                        {% elseif saison.favori %}
                            <span class="badge badge-accent gap-1">{{ icone.i('etoile', 'size-3.5') }} Affichée sur le site</span>
                        {% else %}
                            {{ include('admin/_confirmation.html.twig', {
                                action: path('admin_saison_favorite', {id: saison.id}),
                                token: csrf_token('favorite' ~ saison.id),
                                titre: 'Afficher « ' ~ saison.nom ~ ' » sur le site ?',
                                consequences: [
                                    'Les visiteurs verront cette saison en arrivant sur le site.',
                                    'Les motifs et les auteurs des fermetures de gymnase déjà terminées seront définitivement effacés. Les dates restent : le calendrier affichera toujours « Gymnase fermé ».',
                                    'La fiche du club et les fermetures de gymnase ne seront modifiables que par les responsables désignés pour cette saison. Désignez-les ensuite dans chaque club. Les scores ne changent pas : chacun garde la saisie des saisons pour lesquelles il est désigné.',
                                    'Les rappels de score ne concerneront plus que les matchs de cette saison.',
                                ],
                                bouton: 'Afficher sur le site',
                                ton: 'warning',
                                irreversible: false,
                                declencheur: 'Afficher sur le site',
                                declencheur_sr: saison.nom,
                                declencheur_classe: 'btn btn-ghost btn-sm',
                                declencheur_icone: false,
                            }) }}
                        {% endif %}
                    </td>
                    <td class="pleine-largeur text-right whitespace-nowrap max-md:text-left">
                        {% if saison.brouillon %}
                            {# Brouillon (D29) : on le reprend ou on le supprime ; il n'a encore rien à piloter #}
                            <div class="inline-flex gap-2">
                                <a href="{{ path('admin_saison_wizard_etape', {id: saison.id, etape: saison.etapeWizard|default(2)}) }}" class="btn btn-primary btn-sm">Reprendre<span class="sr-only"> la création de {{ saison.nom }}</span></a>
                                <form method="post" action="{{ path('admin_saison_delete', {id: saison.id}) }}" data-turbo-confirm="Supprimer le brouillon {{ saison.nom }} ? Ses phases, poules et passages seront supprimés.">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ saison.id) }}">
                                    <button type="submit" class="btn btn-ghost btn-error btn-sm" aria-label="Supprimer le brouillon {{ saison.nom }}">{{ icone.i('poubelle') }} Supprimer</button>
                                </form>
                            </div>
                        {% else %}
                            <a href="{{ path('admin_saison_show', {id: saison.id}) }}" class="btn btn-ghost btn-sm">Piloter<span class="sr-only"> {{ saison.nom }}</span></a>
                            <a href="{{ path('admin_saison_edit', {id: saison.id}) }}" class="btn btn-ghost btn-sm" aria-label="Modifier {{ saison.nom }}">{{ icone.i('crayon') }} Modifier</a>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="3" class="pleine-largeur">Aucune saison.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
