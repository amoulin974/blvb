{% extends 'base_admin.html.twig' %}
{# Page d'édition du règlement d'une saison (ReglementController, D55 à D59, maquettes reglement-maquettes-r4.md) :
   éditeur TipTap (reglement_editeur_controller.js), aperçu du texte non enregistré, panneau des éléments calculés. #}
{% import 'admin/_icones.html.twig' as icone %}

{% block title %}Règlement · {{ saison.nom }}{% endblock %}
{% block container_width %}max-w-7xl{% endblock %}

{% block body %}
    {% set publie = not saison.brouillon %}
    {% set auteur = reglement.modifiePar ? (reglement.modifiePar.prenom ? reglement.modifiePar.prenom|first ~ '. ' : '') ~ reglement.modifiePar.nom : null %}
    {% set misAJour = reglement.modifieLe ? 'mis à jour le ' ~ reglement.modifieLe|format_datetime(pattern: 'd MMMM yyyy', locale: 'fr') ~ ' à ' ~ reglement.modifieLe|date('G \\h i') ~ (auteur ? ' par ' ~ auteur : '') : null %}
    {% set actions = [{url: path('admin_reglement_historique', {id: saison.id}), label: 'Historique (' ~ reglement.versions|length ~ ')', icone: 'historique'}] %}
    {% if publie %}
        {% set actions = actions|merge([{url: path('front_reglement', {saison: saison.id}), label: 'Voir la page publique', icone: 'externe'}]) %}
    {% endif %}
    {# Retour : un brouillon se reprend dans le wizard, pas sur la page de la saison (PO1) #}
    {% include 'admin/_entete.html.twig' with {
        titre: 'Règlement de la saison ' ~ saison.nom|replace({'Saison ': ''}),
        sous_titre: saison.brouillon
            ? 'Brouillon : visible par le public quand la saison sera lancée' ~ (misAJour ? ' · ' ~ misAJour : '')
            : (reglement.id ? 'Publié · ' ~ misAJour : 'Pas encore rédigé'),
        retour: saison.brouillon
            ? {url: path('admin_saison_wizard_etape', {id: saison.id, etape: 6}), label: saison.nom ~ ' : vérification'}
            : {url: path('admin_saison_show', {id: saison.id}), label: saison.nom},
        actions: actions,
    } %}

    <div data-controller="reglement-editeur"
         data-reglement-editeur-enregistrer-url-value="{{ path('admin_reglement_enregistrer', {id: saison.id}) }}"
         data-reglement-editeur-apercu-url-value="{{ path('admin_reglement_apercu', {id: saison.id}) }}"
         data-reglement-editeur-image-url-value="{{ path('admin_reglement_image', {id: saison.id}) }}"
         data-reglement-editeur-element-url-value="{{ path('admin_reglement_element', {id: saison.id, code: 'CODE'}) }}"
         data-reglement-editeur-jeton-value="{{ jeton }}"
         data-reglement-editeur-token-value="{{ csrf_token('reglement' ~ saison.id) }}"
         data-reglement-editeur-publie-value="{{ publie ? 'true' : 'false' }}"
         data-reglement-editeur-code-value="{{ app.request.query.get('code', '') }}">

        <div data-reglement-editeur-target="inapplicables">{% include 'admin/reglement/_inapplicables.html.twig' %}</div>

        <a href="#elements-calcules" class="btn btn-ghost btn-sm max-sm:min-h-11 xl:hidden mb-3">Aller aux éléments calculés {{ icone.i('fleche-bas') }}</a>

        <div class="grid gap-6 xl:grid-cols-3">
            <div class="admin-carte p-0 overflow-clip xl:col-span-2 min-w-0">
                <div role="tablist" aria-label="Mode" class="tabs tabs-border px-2 pt-1">
                    <button type="button" role="tab" id="onglet-rediger" class="tab tab-active min-h-11" aria-selected="true" aria-controls="panneau-rediger"
                            data-reglement-editeur-target="ongletRediger" data-action="reglement-editeur#rediger keydown->reglement-editeur#flecheOnglet">Rédiger</button>
                    <button type="button" role="tab" id="onglet-apercu" class="tab min-h-11" aria-selected="false" aria-controls="panneau-apercu" tabindex="-1"
                            data-reglement-editeur-target="ongletApercu" data-action="reglement-editeur#apercu keydown->reglement-editeur#flecheOnglet">Aperçu</button>
                </div>

                <div id="panneau-rediger" role="tabpanel" aria-labelledby="onglet-rediger" data-reglement-editeur-target="panneauRediger">
                    <div role="toolbar" aria-label="Mise en forme" aria-controls="texte-reglement"
                         class="sticky top-0 z-10 flex flex-wrap items-center gap-1 border-y border-base-300 bg-base-100 p-1"
                         data-reglement-editeur-target="barre" data-action="keydown->reglement-editeur#flecheBarre">
                        {# Libellés complets à partir de sm, abrégés sur téléphone ; aria-label donne le nom complet partout #}
                        <button type="button" class="btn btn-ghost btn-sm max-sm:min-h-11 max-sm:min-w-11" data-commande="partie" aria-pressed="false" aria-label="Titre de partie" title="Titre de partie"><span class="sm:hidden">Partie</span><span class="max-sm:hidden">Titre de partie</span></button>
                        <button type="button" class="btn btn-ghost btn-sm max-sm:min-h-11 max-sm:min-w-11" data-commande="regle" aria-pressed="false" tabindex="-1" aria-label="Titre de règle" title="Titre de règle (ex. « RÈGLE 1R : Partie interrompue »)"><span class="sm:hidden">Règle</span><span class="max-sm:hidden">Titre de règle</span></button>
                        <span role="separator" aria-orientation="vertical" class="mx-1 h-6 w-px bg-base-300"></span>
                        <button type="button" class="btn btn-ghost btn-sm btn-square max-sm:size-11 font-bold" data-commande="gras" aria-pressed="false" tabindex="-1" aria-label="Gras" title="Gras (Ctrl+B)">G</button>
                        <button type="button" class="btn btn-ghost btn-sm btn-square max-sm:size-11 italic" data-commande="italique" aria-pressed="false" tabindex="-1" aria-label="Italique" title="Italique (Ctrl+I)">I</button>
                        <button type="button" class="btn btn-ghost btn-sm btn-square max-sm:size-11" data-commande="code" aria-pressed="false" tabindex="-1" aria-label="Code (écrit tel quel)" title="Code, écrit tel quel : un code court mis en forme « code » n'est pas remplacé (Ctrl+E)">{{ icone.i('code') }}</button>
                        <span role="separator" aria-orientation="vertical" class="mx-1 h-6 w-px bg-base-300"></span>
                        <button type="button" class="btn btn-ghost btn-sm btn-square max-sm:size-11" data-commande="puces" aria-pressed="false" tabindex="-1" aria-label="Liste à puces" title="Liste à puces (Ctrl+Maj+8)">{{ icone.i('liste') }}</button>
                        <button type="button" class="btn btn-ghost btn-sm btn-square max-sm:size-11" data-commande="numeros" aria-pressed="false" tabindex="-1" aria-label="Liste numérotée" title="Liste numérotée (Ctrl+Maj+7)">{{ icone.i('liste-numerotee') }}</button>
                        <span role="separator" aria-orientation="vertical" class="mx-1 h-6 w-px bg-base-300"></span>
                        <button type="button" class="btn btn-ghost btn-sm max-sm:min-h-11" data-commande="lien" aria-pressed="false" tabindex="-1" title="Lien (Ctrl+K)">{{ icone.i('lien') }} Lien</button>
                        <button type="button" class="btn btn-ghost btn-sm max-sm:min-h-11" data-commande="image" aria-pressed="false" tabindex="-1" title="Image (JPG, PNG ou WebP, 2 Mo au plus)">{{ icone.i('image') }} Image</button>
                        <input type="file" accept="image/jpeg,image/png,image/webp" class="hidden" data-reglement-editeur-target="fichier" data-action="change->reglement-editeur#envoyerImage" tabindex="-1" aria-hidden="true">
                    </div>
                    <div id="texte-reglement" class="reglement-editeur reglement-article" data-reglement-editeur-target="editeur"></div>
                    <template data-reglement-editeur-target="contenu">{{ contenu|raw }}</template>
                    <noscript><p class="p-4">L'éditeur a besoin de JavaScript.</p></noscript>
                </div>

                <div id="panneau-apercu" role="tabpanel" aria-labelledby="onglet-apercu" tabindex="0" class="hidden p-4 md:p-8" data-reglement-editeur-target="panneauApercu">
                    <p class="reglement-bloc-infos mb-4">Aperçu du texte non enregistré.{% if publie %} Le public voit la version publiée.{% endif %}</p>
                    <div class="reglement-article" data-reglement-editeur-target="apercu"></div>
                </div>

                <div class="sticky bottom-0 z-10 flex flex-wrap items-center justify-between gap-3 border-t border-base-300 bg-base-100 p-2">
                    {% set quand = reglement.modifieLe ? reglement.modifieLe|format_datetime(pattern: "d MMMM 'à' H 'h' mm", locale: 'fr') : null %}
                    <p class="text-sm" aria-live="polite" data-reglement-editeur-target="etat">{{ quand ? (publie ? 'Publié · mis à jour le ' : 'Enregistré le ') ~ quand : 'Pas encore enregistré' }}</p>
                    <button type="button" class="btn btn-accent" aria-disabled="true" aria-describedby="aucune-modification"
                            data-reglement-editeur-target="bouton" data-action="reglement-editeur#enregistrer">{{ publie ? 'Enregistrer et publier' : 'Enregistrer' }}</button>
                    <span id="aucune-modification" class="sr-only" data-reglement-editeur-target="aucuneModification">Aucune modification</span>
                </div>
                <p role="alert" class="px-2 pb-2 text-sm form-erreur empty:hidden" data-reglement-editeur-target="erreur"></p>
            </div>

            <aside id="elements-calcules" aria-labelledby="titre-elements" class="xl:sticky xl:top-4 xl:self-start xl:max-h-[calc(100vh-2rem)] xl:overflow-y-auto space-y-3">
                <h2 id="titre-elements" class="text-lg">Éléments calculés</h2>
                <p class="text-sm text-(--color-base-content)/80">Placez un élément dans le texte avec « Insérer ». Sur la page publique, il est remplacé par l'élément, toujours à jour avec les paramètres de la saison.</p>
                {% for item in blocs %}
                    {% set bloc = item.bloc %}
                    <details class="admin-carte p-0" data-reglement-editeur-target="element" data-code="{{ bloc.code }}">
                        <summary class="flex min-h-11 cursor-pointer items-center gap-2 px-4 font-display uppercase tracking-wide text-primary">{{ bloc.libelle }}<span class="ml-auto">{{ icone.i('fleche-bas') }}</span></summary>
                        <div class="space-y-2 px-4 pb-4 text-sm">
                            <p>{{ bloc.description }}</p>
                            {% set phase = item.parametres|filter(p => p.nom == 'phase')|first %}
                            {% if phase %}
                                <label class="flex flex-col gap-1">
                                    <span>Afficher pour</span>
                                    <select class="select w-full" data-action="reglement-editeur#choisirVariante">
                                        <option value="">Toute la saison</option>
                                        {% for valeur, libelle in phase.valeurs %}<option value="{{ valeur }}">{{ libelle }} ({{ valeur }})</option>{% endfor %}
                                    </select>
                                </label>
                            {% else %}
                                <p class="text-(--color-base-content)/80">Aucun paramètre.</p>
                            {% endif %}
                            <p>Code : <code class="break-all rounded bg-base-200 px-1 font-mono" data-role="code" aria-live="polite">[{{ bloc.code }}]</code></p>
                            <div class="grid grid-cols-2 gap-2">
                                <button type="button" class="btn btn-primary btn-sm max-sm:min-h-11" data-action="reglement-editeur#inserer">{{ icone.i('inserer') }} Insérer</button>
                                <button type="button" class="btn btn-ghost btn-sm max-sm:min-h-11" data-action="reglement-editeur#copier">{{ icone.i('copier') }} <span data-role="libelle-copier">Copier</span></button>
                            </div>
                            {% if item.parametres is not empty %}
                                <details>
                                    <summary class="cursor-pointer min-h-11 flex items-center">Écrire le code à la main</summary>
                                    <dl class="space-y-1">
                                        {% for p in item.parametres %}
                                            <dt><code>{{ p.nom }}</code></dt>
                                            <dd class="pl-3">{{ p.role }} Valeurs : {{ p.valeursEnClair }}. Par défaut : {{ p.defaut }}.</dd>
                                        {% endfor %}
                                    </dl>
                                    <p class="mt-1">Exemple : <code>[{{ bloc.code }} {{ item.parametres|first.nom }}={{ (item.parametres|first.valeurs|keys)|first }}]</code></p>
                                </details>
                            {% endif %}
                            <details data-action="toggle->reglement-editeur#voirResultat">
                                <summary class="cursor-pointer min-h-11 flex items-center">Voir le résultat</summary>
                                <div class="reglement-article mt-2" data-role="resultat" aria-live="polite"></div>
                            </details>
                        </div>
                    </details>
                {% endfor %}
            </aside>
        </div>

        <p class="sr-only" aria-live="polite" data-reglement-editeur-target="annonce"></p>

        {# Fenêtre Lien #}
        <dialog class="modal" data-reglement-editeur-target="dialogueLien" aria-labelledby="titre-lien">
            <form method="dialog" class="modal-box flex flex-col gap-3" data-action="submit->reglement-editeur#validerLien">
                <h2 id="titre-lien" class="text-lg">Lien</h2>
                <label class="flex flex-col gap-1">
                    <span>Adresse</span>
                    <input type="text" class="input w-full" data-reglement-editeur-target="adresse" aria-describedby="aide-lien" autocomplete="off">
                </label>
                <p id="aide-lien" class="text-sm text-(--color-base-content)/80">Une page web (https://…), une adresse e-mail, ou une règle du règlement : #regle-1r</p>
                <p role="alert" class="form-erreur empty:hidden" data-reglement-editeur-target="erreurLien"></p>
                <div class="modal-action">
                    <button type="button" class="btn btn-ghost btn-danger-discret mr-auto hidden" data-reglement-editeur-target="retirerLien" data-action="reglement-editeur#retirerLien">Retirer le lien</button>
                    <button type="button" class="btn btn-ghost" data-action="reglement-editeur#fermerDialogue">Annuler</button>
                    <button type="submit" class="btn btn-primary">Valider</button>
                </div>
            </form>
            <form method="dialog" class="modal-backdrop"><button>Fermer</button></form>
        </dialog>

        {# Fenêtre Image : description obligatoire, ou image décorative #}
        <dialog class="modal" data-reglement-editeur-target="dialogueImage" aria-labelledby="titre-image">
            <form method="dialog" class="modal-box flex flex-col gap-3" data-action="submit->reglement-editeur#validerImage">
                <h2 id="titre-image" class="text-lg">Image</h2>
                <img alt="" class="max-h-40 self-start rounded-box border border-base-300" data-reglement-editeur-target="vignette">
                <label class="flex flex-col gap-1">
                    <span>Description de l'image (lue aux personnes malvoyantes)</span>
                    <input type="text" class="input w-full" data-reglement-editeur-target="description" autocomplete="off">
                </label>
                <label class="flex min-h-11 items-center gap-2"><input type="checkbox" class="checkbox" data-reglement-editeur-target="decorative"> Image décorative (pas de description)</label>
                <p class="text-sm text-(--color-base-content)/80">Pour changer la description plus tard, supprimez l'image et insérez-la de nouveau.</p>
                <p role="alert" class="form-erreur empty:hidden" data-reglement-editeur-target="erreurImage"></p>
                <div class="modal-action">
                    <button type="button" class="btn btn-ghost" data-action="reglement-editeur#fermerDialogue">Annuler</button>
                    <button type="submit" class="btn btn-primary">Insérer l'image</button>
                </div>
            </form>
            <form method="dialog" class="modal-backdrop"><button>Fermer</button></form>
        </dialog>

        {# Fenêtre Conflit (D59) #}
        <dialog class="modal" data-reglement-editeur-target="dialogueConflit" aria-labelledby="titre-conflit">
            <div class="modal-box flex flex-col gap-3">
                <h2 id="titre-conflit" class="text-lg">Une autre version a été {{ publie ? 'publiée' : 'enregistrée' }}</h2>
                <p data-reglement-editeur-target="messageConflit"></p>
                <p>Si vous {{ publie ? 'publiez' : 'enregistrez' }} la vôtre, l'autre reste dans l'historique.</p>
                <div class="modal-action">
                    <button type="button" class="btn btn-ghost" data-action="reglement-editeur#fermerDialogue">Annuler</button>
                    <button type="button" class="btn btn-warning" data-action="reglement-editeur#forcer">{{ publie ? 'Publier' : 'Enregistrer' }} la mienne quand même</button>
                </div>
            </div>
            <form method="dialog" class="modal-backdrop"><button>Fermer</button></form>
        </dialog>
    </div>
{% endblock %}
