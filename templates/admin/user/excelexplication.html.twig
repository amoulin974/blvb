{% extends 'base_admin.html.twig' %}

{% block title %}Ajout de membres avec un fichier{% endblock %}

{% block body %}


{{ include('admin/_entete.html.twig', {
        titre: 'Importer des utilisateurs',
        sous_titre: 'Crée les comptes à partir d\'un fichier Excel, ainsi que les fiches joueurs correspondantes (reliées par l\'adresse e-mail).',
        retour: {url: path('admin_user_index'), label: 'Utilisateurs'},
    }) }}
    <ol class="space-y-4 max-w-3xl">
        <li class="admin-carte">
            <h2 class="text-lg">1. Télécharger le modèle</h2>
            <p class="mt-1"><a class="link link-primary" href="{{ path("admin_user_excel_download") }}">Télécharger le fichier Excel modèle</a></p>
        </li>
        <li class="admin-carte">
            <h2 class="text-lg">2. Compléter le fichier</h2>
            <p class="mt-1">Les comptes créés ont le rôle « Utilisateur » : pour en faire des administrateurs, modifiez-les ensuite un par un. Le téléphone est facultatif ; les lignes dont l'adresse e-mail est invalide sont refusées.</p>
        </li>
        <li class="admin-carte">
            <h2 class="text-lg">3. Envoyer le fichier</h2>
            {{ form_start(form, {'attr': {'enctype': 'multipart/form-data', 'class': 'mt-2 flex flex-wrap items-center gap-3'}}) }}
                {{ form_widget(form.file, {'attr': {'class': 'file-input'}}) }}
                <button class="btn btn-primary">Importer le fichier</button>
                {{ form_errors(form.file) }}
            {{ form_end(form) }}
        </li>
    </ol>

    {# --- BLOC RAPPORT D'ERREURS --- #}
    {% if rapportErreurs is defined and rapportErreurs is not empty %}

        <div class="alert alert-error shadow-lg mt-6">
            <div>
                <span class="font-bold">Rapport des lignes non importées</span>
                <p>Les lignes suivantes ont été ignorées :</p>
            </div>
        </div>

        <div class="overflow-x-auto mt-4">
            <table class="table w-full table-zebra">
                <thead class="bg-gray-200">
                <tr>
                    <th>Ligne Excel #</th>
                    <th>Email concerné</th>
                    <th>Raison du rejet</th>
                </tr>
                </thead>
                <tbody>
                {% for erreur in rapportErreurs %}
                    <tr>
                        <td>{{ erreur.ligne }}</td>
                        <td>{{ erreur.email }}</td>
                        <td class="text-red-600">{{ erreur.raison }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

    {% endif %}
{% endblock %}
