{% extends 'base_admin.html.twig' %}

{% block title %}{{ user.email }}{% endblock %}

{% block body %}
    {{ include('admin/_entete.html.twig', {
        titre: user.email,
        retour: {url: path('admin_user_index'), label: 'Utilisateurs'},
        actions: [{url: path('admin_user_edit', {id: user.id}), label: 'Modifier', icone: 'crayon', principal: true}],
    }) }}
    <div class="admin-carte max-w-2xl">
        <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1">
            <dt class="text-(--color-base-content)/80">Rôle</dt><dd>{{ 'ROLE_ADMIN' in user.roles ? 'Administrateur' : 'Utilisateur' }}</dd>
            <dt class="text-(--color-base-content)/80">Compte vérifié</dt><dd>{{ user.isVerified ? 'Oui' : 'Non' }}</dd>
        </dl>
    </div>
{% endblock %}
