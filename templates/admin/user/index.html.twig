{% extends 'base_admin.html.twig' %}
{% import 'admin/_icones.html.twig' as icone %}

{% block title %}Utilisateurs{% endblock %}

{% block body %}
    {{ include('admin/_entete.html.twig', {
        titre: 'Utilisateurs',
        sous_titre: 'Comptes de connexion. L\'import Excel crée aussi les fiches joueurs.',
        actions: [
            {url: path('admin_user_excel_explication'), label: 'Importer un fichier Excel', icone: 'fichier'},
            {url: path('admin_user_new'), label: 'Créer un utilisateur', icone: 'plus', principal: true},
        ],
    }) }}
    <div class="admin-carte" data-controller="datatable" data-datatable-per-page-value="0" data-datatable-singulier-value="compte" data-datatable-pluriel-value="comptes">
        <div class="mb-3 flex flex-wrap items-center gap-3">
            <label class="input input-sm w-full max-w-xs">
                <span class="sr-only">Rechercher un utilisateur</span>
                <input type="search" placeholder="Rechercher…" data-datatable-target="search" data-action="input->datatable#filter">
            </label>
            <p class="text-sm text-(--color-base-content)/80" data-datatable-target="compteur" aria-live="polite"></p>
        </div>
        <div class="max-lg:overflow-x-auto">
            <table class="table table-admin">
                <thead>
                <tr>
                    <th>E-mail</th>
                    <th>Nom</th>
                    <th>Rôle</th>
                    <th>Compte vérifié</th>
                    <th data-datatable-no-sort><span class="sr-only">Actions</span></th>
                </tr>
                </thead>
                <tbody data-datatable-target="body">
                {% for user in users %}
                    <tr>
                        <td class="break-all"><a class="font-semibold text-(--color-primary) hover:underline" href="{{ path('admin_user_edit', {id: user.id}) }}">{{ user.email }}</a></td>
                        <td>{{ user.prenom }} {{ user.nom }}</td>
                        <td>{% if 'ROLE_ADMIN' in user.roles %}<span class="badge badge-sm badge-primary">Administrateur</span>{% else %}Utilisateur{% endif %}</td>
                        <td>{{ user.isVerified ? 'Oui' : 'Non' }}</td>
                        <td class="text-right"><a href="{{ path('admin_user_edit', {id: user.id}) }}" class="btn btn-ghost btn-sm" aria-label="Modifier le compte {{ user.email }}">{{ icone.i('crayon') }} Modifier</a></td>
                    </tr>
                {% else %}
                    <tr><td colspan="5">Aucun utilisateur.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
