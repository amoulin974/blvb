{% extends 'base_admin.html.twig' %}
{% import 'admin/_icones.html.twig' as icone %}

{# Wizard de création d'une saison (docs/wizard-saison/ecrans.md). Variables : etapes (stepper), etape (numéro courant),
   saison (brouillon, absent à l'étape 1 d'une nouvelle saison). Le formulaire de chaque étape porte l'id « wizard-form » :
   les boutons du stepper et de la barre du bas lui sont rattachés (attribut form) et enregistrent avant de changer d'étape. #}
{% set etape_courante = etapes|filter(e => e.etat == 'en cours')|first %}

{% block title %}Étape {{ etape_courante.numero }} sur 6 : {{ etape_courante.libelle }} · Nouvelle saison{% endblock %}

{% block body %}
    {{ include('admin/_entete.html.twig', {
        titre: saison is defined and saison ? 'Nouvelle saison : ' ~ saison.nom : 'Nouvelle saison',
        sous_titre: 'Brouillon · non visible sur le site',
        retour: {url: path('admin_saison_index'), label: 'Saisons'},
    }) }}

    <nav aria-label="Étapes de création de la saison" class="mb-6">
        <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-(--color-base-content)/80">Organisation</p>
        <ol class="steps w-full">
            {% for e in etapes %}
                {% set classe = e.etat == 'à venir' ? 'step' : 'step step-primary' %}
                <li class="{{ classe }}" data-content="{{ e.etat == 'faite' ? '✓' : e.numero }}" {% if e.etat == 'en cours' %}aria-current="step"{% endif %}>
                    {% if e.accessible and e.etat != 'en cours' %}
                        <button type="submit" form="wizard-form" name="aller" value="{{ e.numero }}" class="max-md:sr-only hover:underline">{{ e.libelle }}<span class="sr-only"> ({{ e.etat }})</span></button>
                    {% else %}
                        <span class="max-md:sr-only {{ e.etat == 'en cours' ? 'font-semibold' : '' }}">{{ e.libelle }}</span><span class="sr-only"> ({{ e.etat }})</span>
                    {% endif %}
                </li>
            {% endfor %}
        </ol>
        <p class="md:hidden mt-2 text-center font-display uppercase tracking-wide">Étape {{ etape_courante.numero }} sur 6 · {{ etape_courante.libelle }}</p>
        <p class="mt-3 text-sm text-(--color-base-content)/80">Mise en place (après validation) : poules, journées, matchs.</p>
    </nav>

    <div class="admin-carte">
        <h2 id="titre-etape" tabindex="-1" class="mb-4">{% block titre_etape %}{{ etape_courante.libelle }}{% endblock %}</h2>
        {% block contenu %}{% endblock %}
    </div>
{% endblock %}
