{% extends 'admin/saisonwizard/layout.html.twig' %}
{% import 'admin/_icones.html.twig' as icone %}

{% block titre_etape %}Vérification{% endblock %}

{% block contenu %}
    {% set erreurs = verification.erreurs %}
    {% set avertissements = verification.avertissements %}
    <form id="wizard-form" method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('wizard' ~ saison.id) }}">

        {% if erreurs is empty %}
            {% embed 'admin/_alerte.html.twig' with {type: 'success', classe: 'mb-4'} %}{% block contenu %}<strong class="font-semibold">La saison est prête à être validée.</strong>{% endblock %}{% endembed %}
        {% else %}
            {% embed 'admin/_alerte.html.twig' with {type: 'error', classe: 'mb-4'} %}{% block contenu %}
                <strong class="font-semibold">{{ erreurs|length }} point{{ erreurs|length > 1 ? 's' : '' }} à corriger</strong>
                <ul class="mt-1 list-disc pl-5 space-y-1">
                    {% for e in erreurs %}<li>{{ e.texte }} <button type="submit" name="aller" value="{{ e.etape }}" class="link">Corriger →</button></li>{% endfor %}
                </ul>
            {% endblock %}{% endembed %}
        {% endif %}
        {% if avertissements is not empty %}
            {% embed 'admin/_alerte.html.twig' with {type: 'warning', classe: 'mb-4'} %}{% block contenu %}
                <strong class="font-semibold">Avertissements (n'empêchent pas de valider)</strong>
                <ul class="mt-1 list-disc pl-5 space-y-1">
                    {% for a in avertissements %}<li>{{ a.texte }} <button type="submit" name="aller" value="{{ a.etape }}" class="link">Vérifier →</button></li>{% endfor %}
                </ul>
            {% endblock %}{% endembed %}
        {% endif %}

        <section class="mb-6" aria-labelledby="schema">
            <h3 id="schema" class="mb-2">Schéma de la saison</h3>
            <div class="max-lg:overflow-x-auto">
                <table class="table table-admin">
                    <caption class="text-left text-sm text-(--color-base-content)/80 pb-2">Lignes : niveaux · colonnes : phases. ▲ montées, ▼ descentes vers la phase suivante.</caption>
                    <thead><tr><th>Niveau</th>{% for c in schema.colonnes %}<th>{{ c }}</th>{% endfor %}</tr></thead>
                    <tbody>
                    {% for niveau, cases in schema.lignes %}
                        <tr>
                            <th scope="row">{{ niveau }}</th>
                            {% for c in cases %}
                                <td>
                                    {% if c %}
                                        {{ c.nom }}{% if c.prevues %} · {{ c.prevues }} équipes{% endif %}
                                        {% if c.montee > 0 %} · <span aria-hidden="true">▲</span>{{ c.montee }}<span class="sr-only"> montée{{ c.montee > 1 ? 's' : '' }}</span>{% endif %}
                                        {% if c.descente > 0 %} · <span aria-hidden="true">▼</span>{{ c.descente }}<span class="sr-only"> descente{{ c.descente > 1 ? 's' : '' }}</span>{% endif %}
                                    {% else %}—{% endif %}
                                </td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>

        <section class="mb-6" aria-labelledby="passages-clair">
            <h3 id="passages-clair" class="mb-2">Passages en clair</h3>
            {% for t in transitions %}
                <h4 class="mt-3 font-semibold">De la {{ t.phase.nom }} vers la {{ t.suivante.nom }}</h4>
                <ul class="mt-1 list-disc pl-5 space-y-1">
                    {% for r in t.regles %}<li>{{ r.enClair }}</li>{% else %}<li>Aucun passage.</li>{% endfor %}
                </ul>
            {% endfor %}
            <details class="mt-3">
                <summary class="cursor-pointer min-h-11 font-semibold">Afficher les codes techniques</summary>
                <ul class="mt-1 list-disc pl-5 font-mono text-sm">
                    {% for t in transitions %}{% for r in t.regles %}<li>{{ r }}</li>{% endfor %}{% endfor %}
                </ul>
            </details>
        </section>

        <section aria-labelledby="recapitulatif">
            <h3 id="recapitulatif" class="mb-2">Récapitulatif</h3>
            <div class="grid gap-3 md:grid-cols-2 lg:grid-cols-3">
                <div class="rounded-box border border-base-300 p-3">
                    <strong>Saison</strong>
                    <p class="text-sm text-(--color-base-content)/80">{{ saison.nom }} · {{ saison.dateDebut|date('d/m/Y') }} → {{ saison.dateFin|date('d/m/Y') }} · {{ sport }} · {{ saison.indisponibilites|length }} période(s) de fermeture</p>
                    <button type="submit" name="aller" value="2" class="btn btn-ghost btn-sm">{{ icone.i('crayon') }} Modifier la saison</button>
                </div>
                <div class="rounded-box border border-base-300 p-3">
                    <strong>Phases</strong>
                    <ul class="text-sm text-(--color-base-content)/80">{% for p in phases %}<li>{{ p.nom }} : {{ libelles[p.type.name][0] }}, {{ p.poules|length }} {{ p.type.name == 'FINALE' ? 'tableau(x)' : 'poule(s)' }}</li>{% endfor %}</ul>
                    <button type="submit" name="aller" value="3" class="btn btn-ghost btn-sm">{{ icone.i('crayon') }} Modifier les phases</button>
                </div>
                <div class="rounded-box border border-base-300 p-3">
                    <strong>Passages</strong>
                    <ul class="text-sm text-(--color-base-content)/80">{% for t in transitions %}<li>{{ t.phase.nom }} → {{ t.suivante.nom }} : {{ t.regles|length }} règle(s)</li>{% endfor %}</ul>
                    <button type="submit" name="aller" value="4" class="btn btn-ghost btn-sm">{{ icone.i('crayon') }} Modifier les passages</button>
                </div>
                <div class="rounded-box border border-base-300 p-3">
                    <strong>Classement</strong>
                    <p class="text-sm text-(--color-base-content)/80">
                        Victoire 3-0 ou 3-1 : {{ saison.pointsVictoireForte }} pts · 3-2 : {{ saison.pointsVictoireFaible }} · défaite 2-3 : {{ saison.pointsDefaiteForte }} · autre défaite : {{ saison.pointsDefaiteFaible }} · forfait : {{ saison.pointsForfait }}
                        {% for p in phases|filter(p => p.bareme is not null) %} · {{ p.nom }} : barème propre{% endfor %}
                        · Départage : {{ saison.departage|map(c => c.libelle)|join(', ') }}
                    </p>
                    <button type="submit" name="aller" value="5" class="btn btn-ghost btn-sm">{{ icone.i('crayon') }} Modifier le classement</button>
                </div>
            </div>
            <p class="mt-4">Après validation : composition des poules de la {{ (phases|first).nom|default('première phase') }}, puis journées et matchs.</p>
        </section>

        <div class="wizard-navigation mt-6 flex flex-wrap items-center gap-2">
            <button type="submit" name="aller" value="precedent" class="btn btn-ghost">← Précédent</button>
            <span class="flex-1"></span>
            <button type="submit" name="aller" value="quitter" class="btn btn-ghost">Enregistrer et quitter</button>
            {% if erreurs is not empty %}<span id="raison-validation" class="text-sm">Corrigez {{ erreurs|length > 1 ? 'les ' ~ erreurs|length ~ ' points' : 'le point' }} ci-dessus pour valider.</span>{% endif %}
            <button type="submit" name="aller" value="valider" class="btn btn-accent" {% if erreurs is not empty %}aria-disabled="true" aria-describedby="raison-validation"{% endif %}>Valider la saison</button>
        </div>
    </form>
{% endblock %}
