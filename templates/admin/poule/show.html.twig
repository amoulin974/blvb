{% extends 'base_admin.html.twig' %}

{% block title %}Poule {{ poule.nom }}{% endblock %}

{% block body %}
    {{ include('admin/_entete.html.twig', {
        titre: 'Poule ' ~ poule.nom,
        sous_titre: poule.phase.saison.nom ~ ' · ' ~ poule.phase.nom,
        retour: {url: path('admin_saison_show', {id: poule.phase.saison.id, openPoule: poule.id}), label: poule.phase.saison.nom},
        actions: [{url: path('admin_poule_edit', {id: poule.id}), label: 'Modifier', icone: 'crayon', principal: true}],
    }) }}
{% endblock %}
