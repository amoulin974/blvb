{% extends 'base_admin.html.twig' %}
{% block title %}
    {% if journee %}Ajouter les parties à la journee {{ journee.numero }} de la poule {{ poule.nom }}{% else %}Tous les matchs de la poule {{ poule.nom }}{% endif %}
{% endblock %}
{% block body %}

    {% if error %}
        <p class="alert alert-error alert-soft" role="alert">{{ error }}</p>
    {% else %}
        {{ include('admin/_entete.html.twig', {
            titre: (journee ? 'Matchs de la journée ' ~ journee.numero : 'Tous les matchs') ~ ' · poule ' ~ poule.nom,
            sous_titre: poule.phase.saison.nom ~ ' · ' ~ poule.phase.nom ~ '. Faites glisser un match pour changer sa date, cliquez dessus pour le modifier.',
            retour: {url: path('admin_saison_show', {id: poule.phase.saison.id, openPoule: poule.id}), label: poule.phase.saison.nom},
            actions: [{url: path('admin_poule_edit', {id: poule.id}), label: 'Modifier la poule', icone: 'crayon'}],
        }) }}

        {# Sélecteur de journée #}
        <nav class="flex flex-wrap gap-1 mb-4" aria-label="Choisir la journée">
            <a class="btn btn-sm {{ not journee ? 'btn-primary' : 'btn-ghost' }}" href="{{ path('admin_partie_getpartiecalendarall', {'id': poule.id}) }}" {% if not journee %}aria-current="page"{% endif %}>Toutes les journées</a>
            {% for majournee in poule.journees %}
                {% set active = journee and majournee.id == journee.id %}
                <a class="btn btn-sm {{ active ? 'btn-primary' : 'btn-ghost' }}" href="{{ path('admin_partie_getpartiecalendar', {id: poule.id, journee: majournee.id}) }}" {% if active %}aria-current="page"{% endif %}>Journée {{ majournee.numero }}</a>
            {% endfor %}
        </nav>

        {% if journee %}
            <div
                id="calendar"
                data-controller="calendar"
                data-calendar-datatype-value="partie"
                data-calendar-journeeid-value={{ journee.id }}
                data-calendar-events-url-value={{ path('admin_partie_api', {'id': poule.id, journee:journee.id}) }}
                data-calendar-datedebut-value="{{ journee.datedebut|date('Y-m-d') }}"
                data-calendar-initialview-value="dayGridSixDay"
                data-calendar-buttons-value="multiMonthFourMonth, dayGridFourWeek"
                data-calendar-duration-value="1"
                data-calendar-pouleid-value="{{ poule.id }}"
                data-calendar-datefin-value="{{ journee.poule.phase.datefin|date('Y-m-d') }}"
                data-calendar-csrf-token-value="{{ csrf_token('update_journee') }}">
            </div>
        {% else %}
            <div
                id="calendar"
                data-controller="calendar"
                data-calendar-datatype-value="partie"
                data-calendar-events-url-value={{ path('admin_partie_apiall', {'id': poule.id}) }}
                data-calendar-datedebut-value="{{ poule.phase.datedebut|date('Y-m-d') }}"
                data-calendar-initialview-value="multiMonthFourMonth"
                data-calendar-buttons-value="multiMonthFourMonth, dayGridFourWeek"
                data-calendar-duration-value="6"
                data-calendar-pouleid-value="{{ poule.id }}"
                data-calendar-datefin-value="{{ poule.phase.datefin|date('Y-m-d') }}"
                data-calendar-csrf-token-value="{{ csrf_token('update_journee') }}">
            </div>
        {% endif %}


        <!-- Modal DaisyUI -->
        <div id="partieModal" class="modal">
        <div class="modal-box">
            <h2 class="font-bold text-lg mb-4" id="eventTitle">Titre de l'événement</h2>
            <hr>
            <h4>Modifier l'événement</h4>
            <div id="modalBody" class="modal-body">
            </div>
            <hr>
            <h4>Supprimer l'événement</h4>
            <div class="modal-action flex flex-row justify-end mt-2">
                <button class="btn btn-error" id="supprimer" >Supprimer l'événement</button>
            </div>
            <hr>
            <div class="modal-action flex flex-row justify-end">
                <button class="btn btn-ghost" id="closeModal" onclick="document.querySelector('#partieModal').classList.remove('modal-open')" >Fermer cette fenêtre</button>
            </div>
        </div>
        </div>
{#        <script src="{{ asset('app.js') }}"></script>#}
        <div id="calendar-tooltip"
             class="fixed hidden z-[9999] bg-slate-800 text-white p-3 rounded-lg shadow-xl text-sm pointer-events-none max-w-xs border border-slate-600">
            <div id="tooltip-content"></div>
            {# Petite flèche #}
            <div class="absolute w-2 h-2 bg-slate-800 rotate-45 -bottom-1 left-1/2 -translate-x-1/2"></div>
        </div>
    {% endif %}

{% endblock %}

