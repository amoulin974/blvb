{% extends 'base.html.twig' %}
{% block title %}Placer les journées à la poule {{ poule.nom }}{% endblock %}
{% block body %}

    {% if error %}
        <p class="alert alert-error">{{ error }}</p>
    {% else %}
        <h1>Placer les journée de la poule {{ poule.nom }}</h1>
        <div class="mb-4">
            <a class="btn btn-sm btn-primary" href="{{ path('admin_saison_show', {'id': poule.phase.saison.id, 'openPoule':poule.id}) }}">Voir la saison</a>
            <a class="btn btn-sm btn-primary" href="{{ path('admin_poule_edit', {'id': poule.id}) }}">Modifier la poule</a>
            {% if poule.journees|length > 0 %}
                <form action="{{ path('admin_journee_deleteall', {'id': poule.id}) }}" method="POST" class="inline" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer toutes les journées de cette poule ? Cette action est irréversible.');">
                    <input type="hidden" name="_token" value="{{ csrf_token('deleteall' ~ poule.id) }}">
                    <button type="submit" class="btn btn-sm btn-error text-white">Supprimer toutes les journées</button>
                </form>
            {% endif %}
        </div>
        <div
            id="calendar"
            data-controller="calendar"
            data-calendar-datatype-value="journee"
            data-calendar-events-url-value="/admin/journee/{{ poule.id }}/api/journees"
            data-calendar-initialview-value="multiMonthFourMonth"
            data-calendar-duration-value="6"
            data-calendar-buttons-value="multiMonthFourMonth, dayGridFourWeek"
            data-calendar-datedebut-value="{{ poule.phase.datedebut|date('Y-m-d') }}"
            data-calendar-pouleid-value="{{ poule.id }}"
            data-calendar-datefin-value="{{ poule.phase.datefin|date('Y-m-d') }}"
            data-calendar-csrf-token-value="{{ csrf_token('update_journee') }}">
        </div>
        <!-- Modal DaisyUI -->
        <div id="eventModal" class="modal">
        <div class="modal-box">
            <h3 class="font-bold text-lg" id="eventTitle">Titre de l'événement</h3>
            <p class="py-4" id="eventDate">Date de l'événement</p>
            <button class="btn btn-error" id="supprimer">Supprimer l'événement</button>
            <div class="modal-action">
            <button class="btn-info" id="closeModal">Fermer</button>
            </div>
        </div>
        </div>
{#        <script src="{{ asset('app.js') }}"></script>#}
    {% endif %}

{% endblock %}
