{% extends 'base_admin.html.twig' %}
{% block title %}Placer les journées à la poule {{ poule.nom }}{% endblock %}
{% block body %}

    {% if error %}
        <p class="alert alert-error alert-soft" role="alert">{{ error }}</p>
    {% else %}
        {{ include('admin/_entete.html.twig', {
            titre: 'Calendrier des journées · poule ' ~ poule.nom,
            sous_titre: poule.phase.saison.nom ~ ' · ' ~ poule.phase.nom ~ '. Faites glisser une journée pour changer ses dates.',
            retour: {url: path('admin_saison_show', {id: poule.phase.saison.id, openPoule: poule.id}), label: poule.phase.saison.nom},
            actions: [{url: path('admin_poule_edit', {id: poule.id}), label: 'Modifier la poule', icone: 'crayon'}],
        }) }}
        {% if poule.journees|length > 0 %}
            <div class="mb-4 flex justify-end">
                {{ include('admin/_confirmation.html.twig', {
                    declencheur: 'Supprimer toutes les journées',
                    titre: 'Supprimer toutes les journées de la poule ' ~ poule.nom ~ ' ?',
                    consequences: [poule.journees|length ~ ' journée(s) seront supprimées' ~ (poule.parties|length > 0 ? ', avec leurs ' ~ poule.parties|length ~ ' match(s) et leurs scores.' : '.'), 'Les équipes sont conservées.'],
                    action: path('admin_journee_deleteall', {id: poule.id}),
                    token: csrf_token('deleteall' ~ poule.id),
                }) }}
            </div>
        {% endif %}
        <div
            id="calendar"
            data-controller="calendar"
            data-calendar-datatype-value="journee"
            data-calendar-events-url-value="{{ path('admin_journee_api', {'id': poule.id}) }}"
            data-calendar-initialview-value="multiMonthFourMonth"
            data-calendar-duration-value="6"
            data-calendar-buttons-value="multiMonthFourMonth, dayGridFourWeek"
            data-calendar-datedebut-value="{{ poule.phase.datedebut|date('Y-m-d') }}"
            data-calendar-pouleid-value="{{ poule.id }}"
            data-calendar-datefin-value="{{ poule.phase.datefin|date('Y-m-d') }}"
            data-calendar-csrf-token-value="{{ csrf_token('update_journee') }}">
        </div>
        <!-- Modal DaisyUI -->
        <div id="eventModal" class="modal">
        <div class="modal-box">
            <h3 class="font-bold text-lg" id="eventTitle">Titre de l'événement</h3>
            <p class="py-4" id="eventDate">Date de l'événement</p>
            <button class="btn btn-error" id="supprimer">Supprimer l'événement</button>
            <div class="modal-action">
            <button class="btn btn-ghost" id="closeModal">Fermer</button>
            </div>
        </div>
        </div>
{#        <script src="{{ asset('app.js') }}"></script>#}
    {% endif %}

{% endblock %}
