{% extends 'base_admin.html.twig' %}
{% import 'admin/_icones.html.twig' as icone %}

{% block title %}Poules{% endblock %}

{% block body %}
    {{ include('admin/_entete.html.twig', {
        titre: 'Poules',
        sous_titre: 'Outil technique : les poules se gèrent normalement depuis la page de chaque saison.',
        actions: [{url: path('admin_poule_new'), label: 'Créer une poule', icone: 'plus', principal: true}],
    }) }}
    <div class="admin-carte" data-controller="datatable" data-datatable-per-page-value="0" data-datatable-singulier-value="poule" data-datatable-pluriel-value="poules">
        <div class="mb-3 flex flex-wrap items-center gap-3">
            <label class="input input-sm w-full max-w-xs">
                <span class="sr-only">Rechercher une poule</span>
                <input type="search" placeholder="Rechercher…" data-datatable-target="search" data-action="input->datatable#filter">
            </label>
            <p class="text-sm text-(--color-base-content)/80" data-datatable-target="compteur" aria-live="polite"></p>
        </div>
        <div class="max-lg:overflow-x-auto">
            <table class="table table-admin">
                <thead>
                <tr><th>Poule</th><th>Saison et phase</th><th>Équipes</th><th data-datatable-no-sort><span class="sr-only">Actions</span></th></tr>
                </thead>
                <tbody data-datatable-target="body">
                {% for poule in poules %}
                    <tr>
                        <td><a class="font-semibold text-(--color-primary) hover:underline" href="{{ path('admin_poule_edit', {id: poule.id}) }}">{{ poule.nom }}</a></td>
                        <td><a class="hover:underline" href="{{ path('admin_saison_show', {id: poule.phase.saison.id, openPoule: poule.id}) }}">{{ poule.phase.saison.nom }} · {{ poule.phase.nom }}</a></td>
                        <td>{{ poule.equipes|length }}</td>
                        <td class="text-right"><a class="btn btn-ghost btn-sm" href="{{ path('admin_poule_edit', {id: poule.id}) }}" aria-label="Modifier {{ poule.nom }}">{{ icone.i('crayon') }} Modifier</a></td>
                    </tr>
                {% else %}
                    <tr><td colspan="4">Aucune poule.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
