{% extends 'base_admin.html.twig' %}

{% block title %}Modifier la poule {{ poule.nom }}{% endblock %}

{% block body %}
    {{ include('admin/_entete.html.twig', {
        titre: 'Modifier la poule ' ~ poule.nom,
        sous_titre: poule.phase.saison.nom ~ ' · ' ~ poule.phase.nom,
        retour: {url: path('admin_saison_show', {id: poule.phase.saison.id, openPoule: poule.id}), label: poule.phase.saison.nom},
        actions: [{url: path('admin_journee_getjourneecalendar', {id: poule.id}), label: 'Calendrier des journées', icone: 'calendrier'}],
    }) }}
    <div class="admin-carte max-w-3xl">
        {{ include('admin/poule/_form.html.twig', {'button_label': 'Enregistrer'}) }}
    </div>
    <div class="max-w-3xl">{{ include('admin/poule/_delete_form.html.twig') }}</div>
{% endblock %}
