{% extends 'base_admin.html.twig' %}
{% import 'admin/_icones.html.twig' as icone %}

{% block title %}Gymnases{% endblock %}

{% block body %}
    {{ include('admin/_entete.html.twig', {
        titre: 'Gymnases',
        sous_titre: 'Lieux de match et leurs créneaux : jour, nombre de terrains, priorité.',
        actions: [{url: path('admin_lieu_new'), label: 'Créer un gymnase', icone: 'plus', principal: true}],
    }) }}
    <div class="admin-carte overflow-x-auto">
        <table class="table table-admin">
            <thead>
            <tr>
                <th>Nom</th>
                <th>Adresse</th>
                <th>Créneaux</th>
                <th><span class="sr-only">Actions</span></th>
            </tr>
            </thead>
            <tbody>
            {% for lieu in lieux %}
                <tr class="align-top">
                    <td><a class="font-semibold text-(--color-primary) hover:underline" href="{{ path('admin_lieu_edit', {id: lieu.id}) }}">{{ lieu.nom }}</a></td>
                    <td>{{ lieu.adresse }}</td>
                    <td>
                        <ul class="space-y-0.5">
                            {% for creneau in lieu.creneaux %}
                                <li>{{ creneau.jourLibelle ?? 'Jour inconnu' }} : {{ creneau.capacite }} terrain{{ creneau.capacite > 1 ? 's' : '' }} <span class="text-(--color-base-content)/70">· priorité {{ creneau.prioritaire }}</span></li>
                            {% else %}
                                <li class="text-(--color-base-content)/70">Aucun créneau</li>
                            {% endfor %}
                        </ul>
                    </td>
                    <td class="text-right"><a class="btn btn-ghost btn-sm" href="{{ path('admin_lieu_edit', {id: lieu.id}) }}" aria-label="Modifier {{ lieu.nom }}">{{ icone.i('crayon') }} Modifier</a></td>
                </tr>
            {% else %}
                <tr><td colspan="4">Aucun gymnase.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
