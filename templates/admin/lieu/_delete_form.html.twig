{# Suppression d'un gymnase (page de modification). Impossible tant qu'une équipe ou un match l'utilise. #}
{% set nbEquipes = lieu.equipes|length %}
{% set nbMatchs = lieu.parties|length %}
{{ include('admin/_zone_suppression.html.twig', {
    resume: 'Supprime le gymnase et ses créneaux.',
    titre: 'Supprimer le gymnase ' ~ lieu.nom ~ ' ?',
    action: path('admin_lieu_delete', {id: lieu.id}),
    token: csrf_token('delete' ~ lieu.id),
    consequences: ['Ses ' ~ lieu.creneaux|length ~ ' créneau(x) seront supprimés.'],
    blocage: nbEquipes > 0 or nbMatchs > 0
        ? 'Ce gymnase est utilisé par ' ~ nbEquipes ~ ' équipe' ~ (nbEquipes > 1 ? 's' : '') ~ ' et ' ~ nbMatchs ~ ' match' ~ (nbMatchs > 1 ? 's' : '') ~ ". Changez d'abord le gymnase de ces équipes et de ces matchs."
        : null,
}) }}
