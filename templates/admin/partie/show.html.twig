{% extends 'base_admin.html.twig' %}

{% block title %}Match{% endblock %}

{% block body %}
    {{ include('admin/_entete.html.twig', {
        titre: partie.nomReception ~ ' contre ' ~ partie.nomDeplacement,
        sous_titre: (partie.date ? partie.date|date('d/m/Y H:i') : 'Date à définir') ~ (partie.nbSetGagnantReception is not null ? ' · score ' ~ partie.nbSetGagnantReception|sets ~ '–' ~ partie.nbSetGagnantDeplacement|sets : ''),
        retour: {url: path('admin_partie_index'), label: 'Matchs'},
        actions: [{url: path('admin_partie_edit', {id: partie.id}), label: 'Modifier', icone: 'crayon', principal: true}],
    }) }}
{% endblock %}
