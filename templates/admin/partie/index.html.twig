{% extends 'base_admin.html.twig' %}
{% import 'admin/_icones.html.twig' as icone %}

{% block title %}Matchs{% endblock %}

{% block body %}
    {{ include('admin/_entete.html.twig', {
        titre: 'Matchs',
        sous_titre: 'Outil technique : les matchs se génèrent et se déplacent depuis la page de chaque saison.',
        actions: [{url: path('admin_partie_new'), label: 'Créer un match', icone: 'plus', principal: true}],
    }) }}
    <div class="admin-carte" data-controller="datatable" data-datatable-per-page-value="100" data-datatable-singulier-value="match" data-datatable-pluriel-value="matchs">
        <div class="mb-3 flex flex-wrap items-center gap-3">
            <label class="input input-sm w-full max-w-xs">
                <span class="sr-only">Rechercher un match</span>
                <input type="search" placeholder="Rechercher…" data-datatable-target="search" data-action="input->datatable#filter">
            </label>
            <p class="text-sm text-(--color-base-content)/80" data-datatable-target="compteur" aria-live="polite"></p>
        </div>
        <div class="max-lg:overflow-x-auto">
            <table class="table table-admin">
                <thead>
                <tr><th>Date</th><th>Match</th><th>Score</th><th>Poule</th><th data-datatable-no-sort><span class="sr-only">Actions</span></th></tr>
                </thead>
                <tbody data-datatable-target="body">
                {% for partie in parties %}
                    <tr>
                        <td class="whitespace-nowrap">{{ partie.date ? partie.date|date('d/m/Y H:i') }}</td>
                        <td><a class="font-semibold text-(--color-primary) hover:underline" href="{{ path('admin_partie_edit', {id: partie.id}) }}">{{ partie.nomReception }} <span class="font-normal text-(--color-base-content)/70">contre</span> {{ partie.nomDeplacement }}</a></td>
                        <td class="tabular-nums whitespace-nowrap">{{ partie.nbSetGagnantReception is not null ? partie.nbSetGagnantReception ~ '–' ~ partie.nbSetGagnantDeplacement : '–' }}</td>
                        <td>{{ partie.poule ? partie.poule.phase.nom ~ ' · ' ~ partie.poule.nom }}</td>
                        <td class="text-right"><a class="btn btn-ghost btn-sm" href="{{ path('admin_partie_edit', {id: partie.id}) }}" aria-label="Modifier le match">{{ icone.i('crayon') }} Modifier</a></td>
                    </tr>
                {% else %}
                    <tr><td colspan="5">Aucun match.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="flex items-center justify-between mt-3" data-datatable-target="pagination"></div>
    </div>
{% endblock %}
