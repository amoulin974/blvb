{# Suppression d'un match. Variables facultatives : declencheur_classe (bouton), icone_seule ; sinon zone de suppression. #}
{% set confirmation = {
    titre: 'Supprimer le match ' ~ partie.nomReception ~ ' contre ' ~ partie.nomDeplacement ~ ' ?',
    action: path('admin_partie_delete', {id: partie.id}),
    token: csrf_token('delete' ~ partie.id),
    consequences: [partie.nbSetGagnantReception is not null ? 'Son score (' ~ partie.nbSetGagnantReception|sets ~ '–' ~ partie.nbSetGagnantDeplacement|sets ~ ') sera perdu.' : "Aucun score n'a été saisi pour ce match."],
} %}
{% if declencheur_classe is defined %}
    {{ include('admin/_confirmation.html.twig', confirmation|merge({declencheur: icone_seule|default(false) ? 'Supprimer le match ' ~ partie.nomReception ~ ' contre ' ~ partie.nomDeplacement : 'Supprimer le match'})) }}
{% else %}
    {{ include('admin/_zone_suppression.html.twig', confirmation|merge({resume: 'Supprime ce match et son score.'})) }}
{% endif %}
