{{ form_start(form, {'attr': {'class': 'space-y-4'}}) }}

        {# Champ Nom de l'équioe #}
<div class="form-control w-full">
    {{ form_label(form.nom, "Nom de l'équipe", {'label_attr': {'class': 'label'}}) }}
    {{ form_widget(form.nom, {'attr': {'class': 'input input-bordered w-full', 'placeholder': "Nom de l'équipe"}}) }}
    {{ form_errors(form.nom) }}
</div>

<div class="form-control w-full">
    {{ form_label(form.lieu, "Lieu d'entrainement habituel de l'équipe", {'label_attr': {'class': 'label'}}) }}
    {{ form_widget(form.lieu, {'attr': {'class': 'input input-bordered w-full', 'placeholder': "Lieu d'entrainement"}}) }}
    {{ form_errors(form.lieu) }}
</div>

<div class="form-control w-full">
    {{ form_label(form.club, "Club de l'équipe", {'label_attr': {'class': 'label'}}) }}
    {{ form_widget(form.club, {'attr': {'class': 'select select-bordered w-full'}}) }}
    <p class="mt-1 text-sm text-(--color-base-content)/70">Les responsables du club peuvent saisir le score des matchs reçus par l'équipe.</p>
    {{ form_errors(form.club) }}
</div>


<button class="btn btn-primary">{{ button_label|default('Sauvegarder') }}</button>
{{ form_end(form) }}
