{% extends 'base_admin.html.twig' %}

{% block title %}Importer des équipes{% endblock %}

{% block body %}
    {{ include('admin/_entete.html.twig', {
        titre: 'Importer des équipes',
        sous_titre: 'Crée plusieurs équipes à partir d\'un fichier Excel.',
        retour: {url: path('admin_equipe_index'), label: 'Équipes'},
    }) }}
    <ol class="space-y-4 max-w-3xl">
        <li class="admin-carte">
            <h2 class="text-lg">1. Télécharger le modèle</h2>
            <p class="mt-1"><a class="link link-primary" href="{{ path('admin_equipe_excel_download') }}">Télécharger le fichier Excel modèle</a></p>
        </li>
        <li class="admin-carte">
            <h2 class="text-lg">2. Compléter le fichier</h2>
            <p class="mt-1">Seuls les gymnases déjà créés peuvent être utilisés. Pour en ajouter un : <a class="link link-primary" href="{{ path('admin_lieu_new') }}">créer un gymnase</a>.</p>
        </li>
        <li class="admin-carte">
            <h2 class="text-lg">3. Envoyer le fichier</h2>
            {{ form_start(form, {'attr': {'enctype': 'multipart/form-data', 'class': 'mt-2 flex flex-wrap items-center gap-3'}}) }}
                {{ form_widget(form.file, {'attr': {'class': 'file-input'}}) }}
                <button class="btn btn-primary">Importer le fichier</button>
                {{ form_errors(form.file) }}
            {{ form_end(form) }}
        </li>
    </ol>
{% endblock %}
