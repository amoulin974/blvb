{# Suppression d'une équipe (page de modification). Impossible tant qu'elle a des matchs ou un classement. #}
{% set nbMatchs = equipe.partiesReception|length + equipe.partiesDeplacement|length %}
{% set nbMembres = equipe.membres|length %}
{% set nbPoules = equipe.poules|length %}
{{ include('admin/_zone_suppression.html.twig', {
    resume: "Supprime l'équipe et sa composition. Les fiches joueurs sont conservées.",
    titre: "Supprimer l'équipe " ~ equipe.nom ~ " ?",
    action: path('admin_equipe_delete', {id: equipe.id}),
    token: csrf_token('delete' ~ equipe.id),
    consequences: [
        nbMembres > 0 ? 'Sa composition (' ~ nbMembres ~ ' joueur' ~ (nbMembres > 1 ? 's' : '') ~ ', toutes saisons) sera supprimée ; les fiches joueurs sont conservées.' : 'Elle n\'a aucun joueur dans sa composition.',
        nbPoules > 0 ? 'Elle sera retirée de ' ~ nbPoules ~ ' poule' ~ (nbPoules > 1 ? 's' : '') ~ '.' : 'Elle n\'est dans aucune poule.',
    ],
    blocage: nbMatchs > 0 or equipe.classements|length > 0
        ? "L'équipe " ~ equipe.nom ~ " a " ~ nbMatchs ~ " match" ~ (nbMatchs > 1 ? 's' : '') ~ " au calendrier ou figure dans un classement : la supprimer effacerait des résultats. Supprimez d'abord ses matchs depuis la page de la saison si elle doit vraiment disparaître."
        : null,
}) }}
