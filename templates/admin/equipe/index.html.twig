{% extends 'base_admin.html.twig' %}
{% import 'admin/_icones.html.twig' as icone %}

{% block title %}Équipes{% endblock %}

{% block body %}
    {{ include('admin/_entete.html.twig', {
        titre: 'Équipes',
        sous_titre: 'Toutes saisons confondues. L\'ajout d\'une équipe dans une poule se fait depuis la poule.',
        actions: [
            {url: path('admin_equipe_excel_explication'), label: 'Importer un fichier Excel', icone: 'fichier'},
            {url: path('admin_equipe_new'), label: 'Créer une équipe', icone: 'plus', principal: true},
        ],
    }) }}
    <div class="admin-carte" data-controller="datatable" data-datatable-per-page-value="0" data-datatable-singulier-value="équipe" data-datatable-pluriel-value="équipes">
        <div class="mb-3 flex flex-wrap items-center gap-3">
            <label class="input input-sm w-full max-w-xs">
                <span class="sr-only">Rechercher une équipe</span>
                <input type="search" placeholder="Rechercher…" data-datatable-target="search" data-action="input->datatable#filter">
            </label>
            <p class="text-sm text-(--color-base-content)/80" data-datatable-target="compteur" aria-live="polite"></p>
        </div>
        <div class="max-lg:overflow-x-auto">
            <table class="table table-admin">
                <thead>
                <tr>
                    <th>Nom</th>
                    <th>Gymnase</th>
                    <th data-datatable-no-sort><span class="sr-only">Actions</span></th>
                </tr>
                </thead>
                <tbody data-datatable-target="body">
                {% for equipe in equipes %}
                    <tr>
                        <td><a class="font-display text-base font-semibold tracking-wide text-(--color-primary) hover:underline" href="{{ path('admin_equipe_show', {id: equipe.id}) }}">{{ equipe.nom }}</a></td>
                        <td>{{ equipe.lieu ? equipe.lieu.nom : '' }}</td>
                        <td class="text-right"><a href="{{ path('admin_equipe_edit', {id: equipe.id}) }}" class="btn btn-ghost btn-sm" aria-label="Modifier {{ equipe.nom }}">{{ icone.i('crayon') }} Modifier</a></td>
                    </tr>
                {% else %}
                    <tr><td colspan="3">Aucune équipe.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
