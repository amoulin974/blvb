{% extends 'base.html.twig' %}

{% block title %}Equipe{% endblock %}

{% block body %}
    <h1>Detail de l'équipe {{ equipe.nom }}</h1>

    <ul>
        <li>id : {{ equipe.id }}</li>
        <li>nom : {{ equipe.nom }}</li>
        <li>Lieu d'entrainement : {{ equipe.lieu.nom }}</li>

        <li>Liste des poules :</li>
            <ul>
        {% for poule in equipe.Poules %}
            {# {{dump(poule)}} #}
                <li>Poule : {{ poule.nom }} de {{ poule.phase.saison.nom }} - {{ poule.phase.nom }}</li>
            {% endfor %}
            </ul>
    </ul>

    <h2 class="mt-4">Composition par saison</h2>
    <ul>
        {% for saison in saisons %}
            <li>
                {{ saison.nom }} —
                <a class="link" href="{{ path('front_equipe_composition_index', {'equipe': equipe.id, 'saison': saison.id}) }}">Gérer la composition</a>
            </li>
        {% else %}
            <li class="opacity-60">Cette équipe n'est encore rattachée à aucune saison (ajoutez-la à une poule).</li>
        {% endfor %}
    </ul>


    <a class="btn btn-sm" href="{{ path('admin_equipe_index') }}">Voir toutes les équipes</a>
    <a class="btn btn-sm" href="{{ path('admin_equipe_new') }}">Créer une nouvelle équipe</a>
{% endblock %}
