{# Suppression d'une fiche joueur (page de modification) : le joueur est d'abord retiré des compositions (JoueurController::delete). #}
{% set consequences = [] %}
{% for membre in joueur.membres %}
    {% set consequences = consequences|merge(['Retiré(e) de la composition de ' ~ membre.equipe.nom ~ ' (' ~ membre.saison.nom ~ ')' ~ (membre.capitaine ? ' : cette équipe n\'aura plus de capitaine.' : '.')]) %}
{% endfor %}
{% set consequences = consequences|merge([joueur.user ? 'Le compte ' ~ joueur.user.email ~ ' est conservé ; il ne sera plus lié à une fiche joueur.' : 'Aucun compte utilisateur n\'est lié à cette fiche.']) %}
{{ include('admin/_zone_suppression.html.twig', {
    resume: "Supprime la fiche et la retire des compositions d'équipe. Le compte utilisateur éventuel est conservé.",
    titre: 'Supprimer la fiche de ' ~ joueur.prenom ~ ' ' ~ joueur.nom ~ ' ?',
    action: path('admin_joueur_delete', {id: joueur.id}),
    token: csrf_token('delete' ~ joueur.id),
    consequences: consequences,
}) }}
