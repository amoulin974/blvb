{% extends 'base_admin.html.twig' %}
{% import 'admin/_icones.html.twig' as icone %}

{% block title %}Joueurs{% endblock %}

{% block body %}
    {{ include('admin/_entete.html.twig', {
        titre: 'Joueurs',
        sous_titre: joueurs|length ~ ' fiches. La composition des équipes se gère depuis la fiche de chaque équipe.',
        actions: [{url: path('admin_joueur_new'), label: 'Créer une fiche joueur', icone: 'plus', principal: true}],
    }) }}
    <div class="admin-carte" data-controller="datatable" data-datatable-per-page-value="25">
        <label class="input input-sm w-full max-w-xs mb-3">
            <span class="sr-only">Rechercher un joueur</span>
            <input type="search" placeholder="Rechercher…" data-datatable-target="search" data-action="input->datatable#filter">
        </label>
        <div class="overflow-x-auto">
            <table class="table table-admin">
                <thead>
                <tr>
                    <th>Nom</th>
                    <th>E-mail</th>
                    <th>Compte</th>
                    <th data-datatable-no-sort><span class="sr-only">Actions</span></th>
                </tr>
                </thead>
                <tbody data-datatable-target="body">
                {% for joueur in joueurs %}
                    <tr>
                        <td><a class="font-semibold text-(--color-primary) hover:underline" href="{{ path('admin_joueur_show', {id: joueur.id}) }}">{{ joueur.nom }} {{ joueur.prenom }}</a></td>
                        <td class="break-all">{{ joueur.email }}</td>
                        <td>{% if joueur.user %}<span class="badge badge-sm badge-soft badge-success">Lié</span>{% else %}<span class="text-(--color-base-content)/70">Aucun</span>{% endif %}</td>
                        <td class="text-right"><a href="{{ path('admin_joueur_edit', {id: joueur.id}) }}" class="btn btn-ghost btn-sm" aria-label="Modifier la fiche de {{ joueur.prenom }} {{ joueur.nom }}">{{ icone.i('crayon') }} Modifier</a></td>
                    </tr>
                {% else %}
                    <tr><td colspan="4">Aucune fiche joueur.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="flex items-center justify-between mt-3" data-datatable-target="pagination"></div>
    </div>
{% endblock %}
