{% extends 'base_admin.html.twig' %}

{% block title %}{{ joueur.prenom }} {{ joueur.nom }}{% endblock %}

{% block body %}
    {{ include('admin/_entete.html.twig', {
        titre: joueur.prenom ~ ' ' ~ joueur.nom,
        retour: {url: path('admin_joueur_index'), label: 'Joueurs'},
        actions: [{url: path('admin_joueur_edit', {id: joueur.id}), label: 'Modifier', icone: 'crayon', principal: true}],
    }) }}
    <div class="grid gap-4 md:grid-cols-2">
        <section class="admin-carte">
            <h2 class="text-lg mb-3">Coordonnées</h2>
            <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1">
                <dt class="text-(--color-base-content)/80">E-mail</dt><dd class="break-all">{{ joueur.email|default('non renseigné') }}</dd>
                <dt class="text-(--color-base-content)/80">Téléphone</dt><dd>{{ joueur.telephone|default('non renseigné') }}</dd>
                <dt class="text-(--color-base-content)/80">Compte</dt><dd class="break-all">{% if joueur.user %}<a class="hover:underline" href="{{ path('admin_user_edit', {id: joueur.user.id}) }}">{{ joueur.user.email }}</a>{% else %}aucun{% endif %}</dd>
            </dl>
        </section>
        <section class="admin-carte">
            <h2 class="text-lg mb-3">Équipes</h2>
            <ul class="space-y-1">
                {% for membre in joueur.membres %}
                    <li>
                        <a class="hover:underline" href="{{ path('admin_equipe_show', {id: membre.equipe.id}) }}">{{ membre.equipe.nom }}</a> · {{ membre.saison.nom }}
                        {% if membre.capitaine %}<span class="badge badge-primary badge-sm">Capitaine</span>{% endif %}
                    </li>
                {% else %}
                    <li class="text-(--color-base-content)/80">Aucune équipe pour l'instant.</li>
                {% endfor %}
            </ul>
        </section>
    </div>
{% endblock %}
