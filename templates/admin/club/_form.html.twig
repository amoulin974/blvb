{# Formulaire d'un club (ClubType) : fiche, puis équipes, gymnases et responsables (listes tom-select). #}
{{ form_start(form, {'attr': {'class': 'space-y-4'}}) }}

{{ include('front/club/_champs_fiche.html.twig') }}

{# Responsables : seulement s'il existe une saison en cours (désignation par saison) #}
{% for champ in [form.equipes, form.lieux]|merge(form.responsables is defined ? [form.responsables] : []) %}
    <div class="form-control w-full">
        {{ form_label(champ, null, {'label_attr': {'class': 'label font-semibold'}}) }}
        {{ form_widget(champ) }}
        <p class="mt-1 text-sm text-(--color-base-content)/70">{{ champ.vars.help }}</p>
        {{ form_errors(champ) }}
    </div>
{% endfor %}

<button class="btn btn-primary">{{ button_label|default('Enregistrer') }}</button>
{{ form_end(form) }}
