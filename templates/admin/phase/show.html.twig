{% extends 'base_admin.html.twig' %}

{% block title %}{{ phase.nom }}{% endblock %}

{% block body %}
    {{ include('admin/_entete.html.twig', {
        titre: phase.nom,
        sous_titre: (phase.datedebut ? 'Du ' ~ phase.datedebut|date('d/m/Y') : '') ~ (phase.datefin ? ' au ' ~ phase.datefin|date('d/m/Y') : ''),
        retour: {url: path('admin_phase_index'), label: 'Phases'},
        actions: [{url: path('admin_phase_edit', {id: phase.id}), label: 'Modifier', icone: 'crayon', principal: true}],
    }) }}
{% endblock %}
