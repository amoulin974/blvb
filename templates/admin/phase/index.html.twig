{% extends 'base_admin.html.twig' %}
{% import 'admin/_icones.html.twig' as icone %}

{% block title %}Phases{% endblock %}

{% block body %}
    {{ include('admin/_entete.html.twig', {
        titre: 'Phases',
        sous_titre: 'Outil technique : les phases se gèrent normalement depuis la page de chaque saison.',
        actions: [{url: path('admin_phase_new'), label: 'Créer une phase', icone: 'plus', principal: true}],
    }) }}
    <div class="admin-carte" data-controller="datatable" data-datatable-per-page-value="25">
        <label class="input input-sm w-full max-w-xs mb-3">
            <span class="sr-only">Rechercher une phase</span>
            <input type="search" placeholder="Rechercher…" data-datatable-target="search" data-action="input->datatable#filter">
        </label>
        <div class="overflow-x-auto">
            <table class="table table-admin">
                <thead>
                <tr><th>Phase</th><th>Saison</th><th>Début</th><th>Fin</th><th data-datatable-no-sort><span class="sr-only">Actions</span></th></tr>
                </thead>
                <tbody data-datatable-target="body">
                {% for phase in phases %}
                    <tr>
                        <td><a class="font-semibold text-(--color-primary) hover:underline" href="{{ path('admin_phase_edit', {id: phase.id}) }}">{{ phase.nom }}</a></td>
                        <td><a class="hover:underline" href="{{ path('admin_saison_show', {id: phase.saison.id}) }}">{{ phase.saison.nom }}</a></td>
                        <td>{{ phase.datedebut ? phase.datedebut|date('d/m/Y') }}</td>
                        <td>{{ phase.datefin ? phase.datefin|date('d/m/Y') }}</td>
                        <td class="text-right"><a class="btn btn-ghost btn-sm" href="{{ path('admin_phase_edit', {id: phase.id}) }}" aria-label="Modifier {{ phase.nom }}">{{ icone.i('crayon') }} Modifier</a></td>
                    </tr>
                {% else %}
                    <tr><td colspan="5">Aucune phase.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="flex items-center justify-between mt-3" data-datatable-target="pagination"></div>
    </div>
{% endblock %}
