{% extends 'base.html.twig' %}
{% block title %}Optimiser les matchs de la phase {{ phase.nom }}{% endblock %}
{% block container_width %}max-w-[107rem]{% endblock %}
{% block body %}
        <h1 class="mb-2">Optimiser les matchs de la phase {{ phase.nom }}</h1>

        <div class="flex items-center gap-3 mb-6">
            <a class="btn btn-sm btn-primary" href="{{ path('admin_saison_show', {'id': phase.saison.id}) }}">Revenir à la saison</a>
            <button type="button" class="btn btn-sm btn-warning" onclick="document.getElementById('modalOptimiserTout').classList.add('modal-open')">Optimiser toutes les poules</button>
        </div>

        <div id="modalOptimiserTout" class="modal">
            <div class="modal-box">
                <h3 class="font-bold text-lg">Optimisation de toutes les poules</h3>
                <p class="py-4">
                    Cette action supprime et recrée tous les matchs de toutes les poules de cette phase.
                    Le calcul peut prendre <strong>plusieurs secondes, jusqu'à une dizaine</strong> selon le
                    nombre d'équipes et de poules : merci de patienter sans recharger la page une fois lancé.
                </p>
                <div class="modal-action">
                    <button type="button" class="btn btn-ghost" onclick="document.getElementById('modalOptimiserTout').classList.remove('modal-open')">Annuler</button>
                    <form action="{{ path('admin_phase_optimisertout', {'id': phase.id}) }}" method="POST">
                        <input type="hidden" name="_token" value="{{ csrf_token('optimisertout' ~ phase.id) }}">
                        <button type="submit" class="btn btn-warning">Lancer l'optimisation</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="flex flex-col lg:flex-row gap-8">
            {# ----------------------------------------------------------- #}
            {# Alternance domicile / extérieur, un tableau par poule       #}
            {# ----------------------------------------------------------- #}
            <div class="w-full lg:w-2/3 min-w-0 space-y-10">
                {% for data in alternance %}
                    <div>
                        <div class="flex items-center gap-3 mb-2">
                            <h2 class="font-bold text-lg">{{ data.poule.nom }}</h2>
                            <form action="{{ path('admin_partie_optimiser', {'id': data.poule.id}) }}" method="POST" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer et recréer les matchs de la poule {{ data.poule.nom }} ? Cette action est irréversible.');">
                                <input type="hidden" name="_token" value="{{ csrf_token('optimiser' ~ data.poule.id) }}">
                                <button type="submit" class="btn btn-xs btn-warning">Optimiser</button>
                            </form>
                        </div>
                        <div class="overflow-x-auto w-full">
                            <table class="table table-xs w-full" style="border-collapse: collapse;">
                                <thead>
                                <tr>
                                    <th class="border-2 border-base-300">Équipe</th>
                                    {% for journee in data.journees %}
                                        <th class="border-2 border-base-300 text-center">J{{ journee.numero }}</th>
                                    {% endfor %}
                                    <th class="border-2 border-base-300 text-center">Dom</th>
                                    <th class="border-2 border-base-300 text-center">Ext</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for row in data.rows %}
                                    <tr>
                                        <td class="border-2 border-base-300 font-semibold whitespace-nowrap">{{ row.equipe.nom }}</td>
                                        {% for journee in data.journees %}
                                            {% set cell = row.cells[journee.id] %}
                                            <td class="border-2 border-base-300 text-center
                                                {% if cell %}
                                                    {% if cell.label == 'Dom' %}bg-success text-success-content
                                                    {% elseif cell.label == 'Der' %}bg-warning text-warning-content
                                                    {% endif %}
                                                {% endif %}">
                                                {% if cell %}
                                                    <span class="tooltip" data-tip="{{ cell.adversaire }}">{{ cell.label }}</span>
                                                {% else %}
                                                    -
                                                {% endif %}
                                            </td>
                                        {% endfor %}
                                        <td class="border-2 border-base-300 text-center font-bold">{{ row.totalDom }}</td>
                                        <td class="border-2 border-base-300 text-center font-bold">{{ row.totalExt }}</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                                <tfoot>
                                <tr>
                                    <td class="border-2 border-base-300 font-semibold">Total Dom</td>
                                    {% for journee in data.journees %}
                                        <td class="border-2 border-base-300 text-center">{{ data.totalDomParJournee[journee.id] }}</td>
                                    {% endfor %}
                                    <td class="border-2 border-base-300"></td>
                                    <td class="border-2 border-base-300"></td>
                                </tr>
                                <tr>
                                    <td class="border-2 border-base-300 font-semibold">Total Ext</td>
                                    {% for journee in data.journees %}
                                        <td class="border-2 border-base-300 text-center">{{ data.totalExtParJournee[journee.id] }}</td>
                                    {% endfor %}
                                    <td class="border-2 border-base-300"></td>
                                    <td class="border-2 border-base-300"></td>
                                </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                {% else %}
                    <em class="text-sm">Aucune poule dans cette phase.</em>
                {% endfor %}
            </div>

            {# ----------------------------------------------------------- #}
            {# Charge des lieux                                            #}
            {# ----------------------------------------------------------- #}
            <div class="w-full lg:w-1/3 min-w-0">
                <h2 class="font-bold text-lg mb-2">Charge des lieux</h2>
                <div class="overflow-x-auto w-full">
                    <table class="table table-xs table-zebra w-full">
                        <thead>
                        <tr>
                            <th>Lieu</th>
                            <th>Date</th>
                            <th class="text-center">Matchs</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for ligne in chargeLieux %}
                            <tr class="{% if ligne.analyse.alerte_capacite %}bg-error text-error-content{% elseif ligne.analyse.alerte_priorite or ligne.analyse.alerte_horscrenau %}bg-warning text-warning-content{% endif %}">
                                <td class="whitespace-nowrap">{{ ligne.lieu.nom }}</td>
                                <td class="whitespace-nowrap">{{ ligne.date|date('d/m/Y') }}</td>
                                <td class="text-center">{{ ligne.nbMatchs }} / {{ ligne.analyse.capacite_max }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="3" class="italic text-xs">Aucun match programmé pour cette phase.</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
{% endblock %}
