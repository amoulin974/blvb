{% extends 'base_admin.html.twig' %}
{% block title %}Optimiser les matchs de la phase {{ phase.nom }}{% endblock %}
{% block container_width %}max-w-[107rem]{% endblock %}
{% block body %}
        {{ include('admin/_entete.html.twig', {
            titre: 'Optimiser les matchs · ' ~ phase.nom,
            sous_titre: phase.saison.nom ~ '. Alternance domicile / extérieur par poule et charge des gymnases.',
            retour: {url: path('admin_saison_show', {id: phase.saison.id}), label: phase.saison.nom},
        }) }}
        <div class="flex items-center gap-3 mb-6">
            {{ include('admin/_confirmation.html.twig', {
                declencheur: 'Optimiser toutes les poules',
                declencheur_icone: 'eclair',
                declencheur_classe: 'btn btn-sm btn-outline btn-warning',
                titre: 'Recalculer les matchs de toutes les poules de ' ~ phase.nom ~ ' ?',
                consequences: [
                    'Tous les matchs de toutes les poules de cette phase sont supprimés puis recréés : scores, dates et gymnases modifiés à la main seront perdus.',
                    'Le calcul peut prendre jusqu\'à une dizaine de secondes : patientez sans recharger la page.',
                ],
                bouton: 'Lancer l\'optimisation',
                ton: 'warning',
                action: path('admin_phase_optimisertout', {id: phase.id}),
                token: csrf_token('optimisertout' ~ phase.id),
            }) }}
        </div>

        {# Légende : les teintes sarcelle = pas de déplacement ; orange / rouge = à surveiller (comme la charge des lieux) #}
        <ul class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm mb-6" aria-label="Légende des tableaux">
            <li class="flex items-center gap-2"><span class="inline-block w-10 text-center text-xs border-2 border-base-300 bg-secondary/30">Dom</span> à domicile</li>
            <li class="flex items-center gap-2"><span class="inline-block w-10 text-center text-xs border-2 border-base-300 bg-secondary/10 italic">Der</span> derby : même gymnase, pas de déplacement</li>
            <li class="flex items-center gap-2"><span class="inline-block w-10 text-center text-xs border-2 border-base-300">Ext</span> à l'extérieur</li>
            <li class="flex items-center gap-2"><span class="inline-block w-10 text-center text-xs border-2 border-base-300 bg-warning/25 font-bold">Ext</span> 2<sup>e</sup> déplacement de suite (break)</li>
            <li class="flex items-center gap-2"><span class="inline-block w-10 text-center text-xs border-2 border-base-300 text-(--color-base-content)/50">-</span> exempt</li>
            <li class="flex items-center gap-2"><span class="inline-block w-10 h-5 border-2 border-base-300 bg-error/20"></span> gymnase surchargé</li>
            <li class="flex items-center gap-2"><span class="inline-block w-10 h-5 border-2 border-base-300 bg-warning/25"></span> créneau non prioritaire ou hors créneau</li>
        </ul>

        <div class="flex flex-col lg:flex-row gap-8">
            {# ----------------------------------------------------------- #}
            {# Alternance domicile / extérieur, un tableau par poule       #}
            {# ----------------------------------------------------------- #}
            <div class="w-full lg:w-2/3 min-w-0 space-y-10">
                {% for data in alternance %}
                    <div>
                        <div class="flex items-center gap-3 mb-2">
                            <h2 class="font-bold text-lg">{{ data.poule.nom }}</h2>
                            {{ include('admin/_confirmation.html.twig', {
                                declencheur: 'Optimiser cette poule',
                                declencheur_icone: 'eclair',
                                declencheur_classe: 'btn btn-xs btn-outline btn-warning',
                                titre: 'Recalculer les matchs de la poule ' ~ data.poule.nom ~ ' ?',
                                consequences: ['Les matchs de la poule sont supprimés puis recréés : scores, dates et gymnases modifiés à la main seront perdus.'],
                                bouton: 'Lancer l\'optimisation',
                                ton: 'warning',
                                action: path('admin_partie_optimiser', {id: data.poule.id}),
                                token: csrf_token('optimiser' ~ data.poule.id),
                            }) }}
                        </div>
                        <div class="overflow-x-auto w-full">
                            <table class="table table-xs w-full" style="border-collapse: collapse;">
                                <thead>
                                <tr>
                                    <th class="border-2 border-base-300">Équipe</th>
                                    {% for journee in data.journees %}
                                        <th class="border-2 border-base-300 text-center">J{{ journee.numero }}</th>
                                    {% endfor %}
                                    <th class="border-2 border-base-300 text-center">Dom</th>
                                    <th class="border-2 border-base-300 text-center">Ext</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for row in data.rows %}
                                    <tr>
                                        <td class="border-2 border-base-300 font-semibold whitespace-nowrap">{{ row.equipe.nom }}</td>
                                        {% for journee in data.journees %}
                                            {% set cell = row.cells[journee.id] %}
                                            <td class="border-2 border-base-300 text-center
                                                {% if not cell %}text-(--color-base-content)/50
                                                {% elseif cell.break %}bg-warning/25 font-bold
                                                {% elseif cell.label == 'Dom' %}bg-secondary/30
                                                {% elseif cell.label == 'Der' %}bg-secondary/10 italic
                                                {% endif %}">
                                                {% if cell %}
                                                    <span class="tooltip" data-tip="{{ cell.adversaire }}{{ cell.break ? ' · 2e déplacement de suite' }}">{{ cell.label }}{% if cell.break %}<span class="sr-only"> (2e déplacement de suite)</span>{% endif %}</span>
                                                {% else %}
                                                    <span title="Exempt">-</span>
                                                {% endif %}
                                            </td>
                                        {% endfor %}
                                        <td class="border-2 border-base-300 text-center font-bold">{{ row.totalDom }}</td>
                                        <td class="border-2 border-base-300 text-center font-bold">{{ row.totalExt }}</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                                <tfoot>
                                <tr>
                                    <td class="border-2 border-base-300 font-semibold">Total Dom</td>
                                    {% for journee in data.journees %}
                                        <td class="border-2 border-base-300 text-center">{{ data.totalDomParJournee[journee.id] }}</td>
                                    {% endfor %}
                                    <td class="border-2 border-base-300"></td>
                                    <td class="border-2 border-base-300"></td>
                                </tr>
                                <tr>
                                    <td class="border-2 border-base-300 font-semibold">Total Ext</td>
                                    {% for journee in data.journees %}
                                        <td class="border-2 border-base-300 text-center">{{ data.totalExtParJournee[journee.id] }}</td>
                                    {% endfor %}
                                    <td class="border-2 border-base-300"></td>
                                    <td class="border-2 border-base-300"></td>
                                </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                {% else %}
                    <em class="text-sm">Aucune poule dans cette phase.</em>
                {% endfor %}
            </div>

            {# ----------------------------------------------------------- #}
            {# Charge des lieux                                            #}
            {# ----------------------------------------------------------- #}
            <div class="w-full lg:w-1/3 min-w-0">
                <h2 class="font-bold text-lg mb-2">Charge des lieux</h2>
                <div class="overflow-x-auto w-full">
                    <table class="table table-xs w-full">
                        <thead>
                        <tr>
                            <th>Lieu</th>
                            <th>Date</th>
                            <th class="text-center">Matchs</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for ligne in chargeLieux %}
                            <tr class="{% if ligne.analyse.alerte_capacite %}bg-error/20 font-semibold{% elseif ligne.analyse.alerte_priorite or ligne.analyse.alerte_horscrenau %}bg-warning/25{% endif %}"
                                {% if ligne.analyse.alerte_capacite %}title="Gymnase surchargé"{% elseif ligne.analyse.alerte_priorite or ligne.analyse.alerte_horscrenau %}title="Créneau non prioritaire ou hors créneau"{% endif %}>
                                <td class="whitespace-nowrap">{{ ligne.lieu.nom }}</td>
                                <td class="whitespace-nowrap">{{ ligne.date|date('d/m/Y') }}</td>
                                <td class="text-center">{{ ligne.nbMatchs }} / {{ ligne.analyse.capacite_max }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="3" class="italic text-xs">Aucun match programmé pour cette phase.</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
{% endblock %}
