{% extends 'base_auth.html.twig' %}

{% block title %}Connexion - BLVB{% endblock %}

{% block auth_body %}
    <h1>Connexion</h1>
    <p>Espace réservé aux capitaines et aux administrateurs, pour saisir les résultats et gérer les équipes.</p>

    {% if error %}
        <div class="alert alert-error" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    {% if app.user %}
        <div class="alert alert-info" role="status">
            Vous êtes connecté en tant que {{ app.user.userIdentifier }}.
        </div>
    {% endif %}

    <form method="post" class="flex flex-col gap-4">
        <div class="flex flex-col gap-1">
            <label for="username" class="font-medium">Adresse e-mail</label>
            <input type="email" value="{{ last_username }}" name="_username" id="username"
                   class="input w-full text-base" autocomplete="email" required autofocus>
        </div>
        <div class="flex flex-col gap-1">
            <label for="password" class="font-medium">Mot de passe</label>
            <input type="password" name="_password" id="password"
                   class="input w-full text-base" autocomplete="current-password" required>
        </div>

        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

        {#
            Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
            See https://symfony.com/doc/current/security/remember_me.html

            <div class="checkbox mb-3">
                <input type="checkbox" name="_remember_me" id="_remember_me">
                <label for="_remember_me">Remember me</label>
            </div>
        #}

        <button type="submit" class="btn btn-accent w-full">Se connecter</button>

        <a href="{{ path('app_forgot_password_request') }}" class="link link-hover link-primary w-fit">J’ai oublié mon mot de passe</a>
    </form>
{% endblock %}
