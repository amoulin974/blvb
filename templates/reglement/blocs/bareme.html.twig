{# [bareme] (App\Reglement\Bloc\BlocBareme, D58) : un tableau par format de match ; phases sans points en une phrase. #}
<section class="reglement-bloc" data-bloc="bareme" aria-label="Barème des points">
    {% if tableaux is not empty %}
        <div class="reglement-baremes">
            {% for tableau in tableaux %}
                <table class="table table-sm reglement-table">
                    <caption>{{ tableau.titre }} · {{ tableau.sets }} sets gagnants</caption>
                    <thead>
                        <tr><th scope="col">Résultat</th><th scope="col" class="text-center">Points</th></tr>
                    </thead>
                    <tbody>
                        {% for ligne in tableau.lignes %}
                            <tr>
                                <th scope="row" class="font-normal">{{ ligne.resultat }}{% if ligne.regle1R|default(false) %} (<a class="link link-primary" href="#regle-1r">règle 1R</a>){% endif %}</th>
                                <td class="text-center tabular-nums">{{ ligne.points }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endfor %}
        </div>
    {% endif %}
    {% for phrase in sansPoints %}
        <p class="reglement-bloc-infos">{{ phrase }}</p>
    {% endfor %}
</section>
