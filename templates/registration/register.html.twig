{% extends 'base_auth.html.twig' %}

{% block title %}Créer un compte - BLVB{% endblock %}

{% block auth_body %}
    {% for flash_error in app.flashes('verify_email_error') %}
        <div class="alert alert-error" role="alert">{{ flash_error }}</div>
    {% endfor %}

    <h1>Créer un compte</h1>

    {{ form_errors(registrationForm) }}

    {{ form_start(registrationForm, {'attr': {
        'class': 'flex flex-col gap-4',
        'data-controller': 'password-rules',
        'data-action': 'submit->password-rules#preventInvalidSubmit'
    }}) }}
        <div class="flex flex-col gap-1">
            {{ form_label(registrationForm.email, 'Email* :', {'label_attr': {'class': 'font-medium'}}) }}
            {{ form_widget(registrationForm.email, {'attr': {'class': 'input w-full text-base', 'placeholder': 'Email', 'type':'email'}}) }}
            {{ form_errors(registrationForm.email) }}
        </div>
        <div class="flex flex-col gap-1">
            {{ form_label(registrationForm.plainPassword, 'Mot de passe* :', {'label_attr': {'class': 'font-medium'}}) }}
            {{ form_widget(registrationForm.plainPassword, {'attr': {
                'class': 'input w-full text-base',
                'placeholder': 'Mot de passe',
                'type':'password',
                'data-password-rules-target': 'password',
                'data-action': 'input->password-rules#update'
            }}) }}
            <div data-password-rules-target="rules"></div>
            {{ form_errors(registrationForm.plainPassword) }}
        </div>
    <div class="flex flex-col gap-1">
        {{ form_label(registrationForm.prenom, 'Prénom* :', {'label_attr': {'class': 'font-medium'}}) }}
        {{ form_widget(registrationForm.prenom, {'attr': {'class': 'input w-full text-base', 'placeholder': 'prenom', 'type':'text'}}) }}
        {{ form_errors(registrationForm.prenom) }}
    </div>
    <div class="flex flex-col gap-1">
        {{ form_label(registrationForm.nom, 'Nom :', {'label_attr': {'class': 'font-medium'}}) }}
        {{ form_widget(registrationForm.nom, {'attr': {'class': 'input w-full text-base', 'placeholder': 'Nom', 'type':'text'}}) }}
        {{ form_errors(registrationForm.nom) }}
    </div>
    <div class="flex flex-col gap-1">
        {{ form_label(registrationForm.telephone, 'Téléphone :', {'label_attr': {'class': 'font-medium'}}) }}
        {{ form_widget(registrationForm.telephone, {'attr': {'class': 'input w-full text-base', 'placeholder': 'Téléphone', 'type':'tel'}}) }}
        {{ form_errors(registrationForm.telephone) }}
    </div>
        {{ form_row(registrationForm.agreeTerms) }}

        <button type="submit" class="btn btn-accent w-full">Créer le compte</button>
    {{ form_end(registrationForm) }}
{% endblock %}
