{% extends 'base_auth.html.twig' %}

{% block title %}Nouveau mot de passe - BLVB{% endblock %}

{% block auth_body %}
        <h1>Nouveau mot de passe</h1>

        {{ form_start(resetForm, {'attr': {
            'data-controller': 'password-rules',
            'data-action': 'submit->password-rules#preventInvalidSubmit'
        }}) }}

        <div class="flex flex-col gap-1 mb-4">
            {{ form_label(resetForm.plainPassword.first, 'Nouveau mot de passe', {'label_attr': {'class': 'font-medium'}}) }}
            {{ form_widget(resetForm.plainPassword.first, {'attr': {
                'class': 'input w-full text-base',
                'data-password-rules-target': 'password',
                'data-action': 'input->password-rules#update'
            }}) }}
            <div data-password-rules-target="rules"></div>
{#            {{ form_errors(resetForm.plainPassword.first) }}#}
            {# Messages d'erreur personnalisés #}
            {% for error in resetForm.plainPassword.first.vars.errors %}
                <p class="alert alert-error mt-2">{{ error.message }}</p>
            {% endfor %}
        </div>

        {# Confirmation mot de passe #}
        <div class="flex flex-col gap-1 mb-4">
            {{ form_label(resetForm.plainPassword.second, 'Confirmez le mot de passe', {'label_attr': {'class': 'font-medium'}}) }}
            {{ form_widget(resetForm.plainPassword.second, {'attr': {
                'class': 'input w-full text-base',
                'data-password-rules-target': 'confirm',
                'data-action': 'input->password-rules#update'
            }}) }}
            <div data-password-rules-target="matchRules"></div>
            {# Messages d'erreur personnalisés #}
            {% for error in resetForm.plainPassword.second.vars.errors %}
                <p class="alert alert-error mt-2">{{ error.message }}</p>
            {% endfor %}
            {# L'erreur "les mots de passe ne correspondent pas" est portée par le champ
               composé plainPassword lui-même, pas par .first ni .second. #}
            {% for error in resetForm.plainPassword.vars.errors %}
                <p class="alert alert-error mt-2">{{ error.message }}</p>
            {% endfor %}
        </div>

        <button type="submit" class="btn btn-accent w-full" data-password-rules-target="submit">Enregistrer le nouveau mot de passe</button>
        {{ form_end(resetForm) }}
{% endblock %}
