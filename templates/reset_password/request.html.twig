{% extends 'base_auth.html.twig' %}

{% block title %}Mot de passe oublié - BLVB{% endblock %}

{% block auth_body %}
    {% for flash_error in app.flashes('reset_password_error') %}
        <div class="alert alert-error" role="alert">{{ flash_error }}</div>
    {% endfor %}
    <h1>Réinitialiser votre mot de passe</h1>

    {{ form_start(requestForm, {'attr': {'class': 'flex flex-col gap-4'}}) }}

        <div class="flex flex-col gap-1">
            {{ form_label(requestForm.email, 'Adresse e-mail', {'label_attr': {'class': 'font-medium'}}) }}
            {{ form_widget(requestForm.email, {'attr': {'class': 'input w-full text-base', 'autocomplete': 'email'}}) }}
            {{ form_errors(requestForm.email) }}
            <small class="text-sm mt-1 block">
                Entrez votre adresse mail et nous vous enverrons un lien pour réinitialiser votre mot de passe.
            </small>
        </div>

        <button class="btn btn-accent w-full">Envoyer le lien de réinitialisation</button>

{{ form_end(requestForm) }}
{% endblock %}
