{% extends 'base_front.html.twig' %}

{% block title %}Calendrier par gymnase — {{ saison.nom }} - BLVB{% endblock %}

{% block body %}
    <div class="container mx-auto max-w-7xl md:px-4">
        <h1>Calendrier par gymnase — {{ saison.nom }}</h1>
{#        TODO enlever le badge du nombre d ematch, et ajouter les alerts dans la vue mobile#}
        {% for phase in saison.phases %}
            <div class="bg-base-100 border-base-300 collapse collapse-arrow md:border mb-4">
                <input type="checkbox" {% if phaseouverte and phaseouverte.id == phase.id %}checked{% endif %} class="peer" />

                <div class="collapse-title font-display text-xl font-semibold">
                    {{ phase.nom }}
                </div>

                <div class="collapse-content px-2 md:px-4">
                    {# --- FILTRE (barre d'outils séparée des gymnases) --- #}
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                        <label for="lieuFilter_{{phase.id}}">Filtrer par gymnase</label>
                        {# data-filtre-mon-equipe : mon_equipe_controller.js y sélectionne le gymnase de l'équipe suivie #}
                        <select id="lieuFilter_{{phase.id}}" data-filtre-mon-equipe class="select w-full text-base sm:w-72 md:select-sm md:text-sm" onchange="filterLieu({{phase.id}})">
                            <option value="all">Tous les gymnases</option>
                            {% for lieu in lieux %}
                                {# On n'affiche dans le select que les lieux qui ont des matchs pour cette phase #}
                                {% if lieu.partiesByDate[phase.id] is defined %}
                                    <option value="{{lieu.id}}" data-equipes="{{ lieu.equipes|map(e => e.id)|join(' ') }}">{{lieu.nom}}</option>
                                {% endif %}
                            {% endfor %}
                        </select>
                    </div>

                    {# --- LISTE DES LIEUX --- #}
                    {% for lieu in lieux %}
                        {# On vérifie s'il y a des matchs pour ce lieu et cette phase #}
                        {% if lieu.partiesByDate[phase.id] is defined %}

                            <div class="pt-6 mt-4 border-t border-base-300" data-idphase="{{ phase.id }}" data-lieu="{{ lieu.id }}">

                                {# En-tête du gymnase : nom, adresse, créneaux #}
                                <div class="mb-3">
                                    <h3 class="text-2xl uppercase tracking-wide text-(--color-primary)">{{ lieu.nom }}</h3>
                                    <p class="text-sm">
                                        <a class="link link-hover link-primary focus-visible:underline" href="https://maps.google.com/?q={{ lieu.adresse|url_encode }}" target="_blank" rel="noopener noreferrer">{{ lieu.adresse }}</a>
                                    </p>
                                    <p class="text-sm">
                                        Créneaux :
                                        {% for creneau in lieu.creneaux %}{{ loop.first ? '' : ' · ' }}{{ creneau.jourLibelle }} {{ creneau.heureDebut|format_time('short', locale='fr') }}{% else %}<span class="italic">aucun créneau défini</span>{% endfor %}
                                    </p>
                                </div>

                                {# --- VUE TABLEAU (ordinateur) --- #}
                                <div class="hidden md:block">
                                    <table class="table w-full table-fixed">
                                        <colgroup>
                                            <col class="w-[17%]">
                                            <col class="w-[55%]">
                                            <col class="w-[10%]">
                                            <col class="w-[18%]">
                                        </colgroup>
                                        <thead>
                                        <tr class="border-b-2 border-(--color-primary) text-xs uppercase tracking-wider text-(--color-base-content)/70">
                                            <th>Date</th>
                                            <th>Matchs</th>
                                            <th class="text-center">Occupation</th>
                                            <th>Statut</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        {% for date, parties in lieu.partiesByDate[phase.id] %}
                                            {# On récupère l'analyse calculée dans le contrôleur #}
                                            {% set analyse = lieu.analysesByDate[phase.id][date] %}
                                            {% set alerte = analyse.alerte_horscrenau or analyse.alerte_capacite or analyse.alerte_priorite %}
                                            <tr class="align-top {{ alerte ? 'bg-(--color-error)/5' : '' }}">
                                                <td class="font-display text-[17px] font-semibold tracking-wide">{{ date|format_date('full', locale='fr')|capitalize }}</td>
                                                <td>
                                                    <ul class="flex flex-col gap-1 text-base">
                                                        {% for partie in parties %}
                                                            <li class="rounded px-1 -mx-1" data-recoit="{{ partie.idEquipeRecoit.id }}" data-deplace="{{ partie.idEquipeDeplace.id }}">
                                                                <span class="font-display font-medium tracking-wide">{{ partie.idEquipeRecoit.nom }}</span>
                                                                <span class="text-(--color-base-content)/70">contre</span>
                                                                <span class="font-display font-medium tracking-wide">{{ partie.idEquipeDeplace.nom }}</span>
                                                                <span class="text-sm text-(--color-base-content)/70 whitespace-nowrap">· {{ partie.poule.nom }}</span>
                                                            </li>
                                                        {% endfor %}
                                                    </ul>
                                                </td>
                                                <td class="text-center font-display text-xl font-bold tabular-nums whitespace-nowrap">{{ parties|length }} / {{ analyse.capacite_max }}</td>
                                                <td>{{ include('front/fragments/_lieu_alertes.html.twig') }}</td>
                                            </tr>
                                        {% endfor %}
                                        </tbody>
                                    </table>
                                </div>

                                {# --- VUE CARTES (mobile) --- #}
                                <div class="md:hidden flex flex-col gap-2">
                                    {% for date, parties in lieu.partiesByDate[phase.id] %}
                                        {% set analyse = lieu.analysesByDate[phase.id][date] %}
                                        {% set alerte = analyse.alerte_horscrenau or analyse.alerte_capacite or analyse.alerte_priorite %}
                                        <div class="card card-xs border border-base-300 {{ alerte ? 'bg-(--color-error)/5' : 'bg-base-100' }}">
                                            <div class="card-body px-3 py-2 gap-1">
                                                <div class="flex items-center justify-between gap-3">
                                                    <h4 class="font-display text-lg font-semibold tracking-wide">{{ date|format_date('full', locale='fr')|capitalize }}</h4>
                                                    <span class="shrink-0 font-display text-lg font-bold tabular-nums"><span class="sr-only">Occupation : </span>{{ parties|length }} / {{ analyse.capacite_max }}</span>
                                                </div>
                                                <ul class="flex flex-col gap-0.5 text-base">
                                                    {% for partie in parties %}
                                                        <li class="rounded px-1 -mx-1" data-recoit="{{ partie.idEquipeRecoit.id }}" data-deplace="{{ partie.idEquipeDeplace.id }}">
                                                            <span class="font-display font-medium tracking-wide">{{ partie.idEquipeRecoit.nom }}</span>
                                                            <span class="text-(--color-base-content)/70">contre</span>
                                                            <span class="font-display font-medium tracking-wide">{{ partie.idEquipeDeplace.nom }}</span>
                                                            <span class="text-sm text-(--color-base-content)/70 whitespace-nowrap">· {{ partie.poule.nom }}</span>
                                                        </li>
                                                    {% endfor %}
                                                </ul>
                                                {{ include('front/fragments/_lieu_alertes.html.twig') }}
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>

                            </div>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}

{% block extra_scripts %}
    <script>
        function filterLieu(phaseId) {
            const select = document.getElementById('lieuFilter_' + phaseId);
            const value = select.value; // L'ID du lieu ou "all"

            // On sélectionne tous les conteneurs de cette phase qui ont un attribut data-lieu
            const divs = document.querySelectorAll(`div[data-idphase="${phaseId}"][data-lieu]`);

            divs.forEach(div => {
                // Si "all" est sélectionné OU si l'ID correspond
                if (value === 'all' || div.dataset.lieu === value) {
                    div.style.display = ''; // On affiche (retour au style par défaut)
                    // Animation optionnelle pour faire joli
                    div.style.opacity = '1';
                } else {
                    div.style.display = 'none'; // On cache
                }
            });
        }
    </script>
{% endblock %}
