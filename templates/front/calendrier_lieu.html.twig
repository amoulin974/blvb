{% extends 'base_front.html.twig' %}

{% block title %}Calendrier par gymnase — {{ saison.nom }} - BLVB{% endblock %}

{% block body %}
    <div class="container mx-auto max-w-7xl md:px-4">
        <h1>Calendrier par gymnase — {{ saison.nom }}</h1>
{#        TODO enlever le badge du nombre d ematch, et ajouter les alerts dans la vue mobile#}
        {% for phase in saison.phases %}
            <div class="bg-base-100 border-base-300 collapse collapse-arrow md:border mb-4">
                <input type="checkbox" {% if phaseouverte and phaseouverte.id == phase.id %}checked{% endif %} class="peer" />

                <div class="collapse-title font-display text-xl font-semibold">
                    {{ phase.nom }}
                </div>

                <div class="collapse-content px-2 md:px-4">
                    {# --- FILTRE (barre d'outils séparée des gymnases) --- #}
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                        <label for="lieuFilter_{{phase.id}}">Filtrer par gymnase</label>
                        {# data-filtre-mon-equipe : mon_equipe_controller.js y sélectionne le gymnase de l'équipe suivie #}
                        <select id="lieuFilter_{{phase.id}}" data-filtre-mon-equipe class="select w-full text-base sm:w-72 md:select-sm md:text-sm" onchange="filterLieu({{phase.id}})">
                            <option value="all">Tous les gymnases</option>
                            {% for lieu in lieux %}
                                {# On n'affiche dans le select que les lieux qui ont des matchs pour cette phase #}
                                {% if lieu.partiesByDate[phase.id] is defined %}
                                    <option value="{{lieu.id}}" data-equipes="{{ lieu.equipes|map(e => e.id)|join(' ') }}">{{lieu.nom}}</option>
                                {% endif %}
                            {% endfor %}
                        </select>
                        {# Pour les responsables de gymnase : ne garder que les dates en surcharge ou hors créneau #}
                        <label class="flex items-center gap-2 cursor-pointer md:ml-auto py-1">
                            <input type="checkbox" id="alertesSeules_{{phase.id}}" class="checkbox checkbox-sm" onchange="filterLieu({{phase.id}})">
                            Seulement les dates à problème
                        </label>
                    </div>
                    <p id="aucuneAlerte_{{phase.id}}" class="hidden alert alert-success mt-4" role="status">Aucune date à problème pour cette sélection.</p>
                    {% set aujourdhui = 'now'|date('Y-m-d') %}

                    {# --- LISTE DES LIEUX --- #}
                    {% for lieu in lieux %}
                        {# On vérifie s'il y a des matchs pour ce lieu et cette phase #}
                        {% if lieu.partiesByDate[phase.id] is defined %}

                            {% set aAlerte = lieu.analysesByDate[phase.id]|filter(a => a.alerte_horscrenau or a.alerte_capacite or a.alerte_priorite)|length > 0 %}
                            <div class="pt-6 mt-4 border-t border-base-300" data-idphase="{{ phase.id }}" data-lieu="{{ lieu.id }}" data-a-alerte="{{ aAlerte ? 1 : 0 }}">

                                {# En-tête du gymnase : nom, adresse, créneaux #}
                                <div class="mb-3">
                                    <h3 class="text-2xl uppercase tracking-wide text-(--color-primary)">{{ lieu.nom }}</h3>
                                    <p class="text-sm">
                                        <a class="link link-hover link-primary focus-visible:underline" href="https://maps.google.com/?q={{ lieu.adresse|url_encode }}" target="_blank" rel="noopener noreferrer">{{ lieu.adresse }}</a>
                                    </p>
                                    <p class="text-sm">
                                        Créneaux :
                                        {% for creneau in lieu.creneaux %}{{ loop.first ? '' : ' · ' }}{{ creneau.jourLibelle }} {{ creneau.heureDebut|format_time('short', locale='fr') }}{% else %}<span class="italic">aucun créneau défini</span>{% endfor %}
                                    </p>
                                </div>

                                {# Dates passées repliées ; la page s'ouvre sur les prochaines dates #}
                                {% set datesLieu = lieu.partiesByDate[phase.id] %}
                                {% set passees = datesLieu|filter((parties, date) => date < aujourdhui) %}
                                {% set aVenir = datesLieu|filter((parties, date) => date >= aujourdhui) %}
                                {% if passees|length > 0 %}
                                    <details class="mb-3" data-passees>
                                        <summary class="cursor-pointer w-fit link link-hover link-primary">Dates passées ({{ passees|length }})</summary>
                                        <div class="mt-2">{{ include('front/fragments/_lieu_dates.html.twig', {dates: passees}) }}</div>
                                    </details>
                                {% endif %}
                                {% if aVenir|length > 0 %}
                                    {{ include('front/fragments/_lieu_dates.html.twig', {dates: aVenir}) }}
                                {% else %}
                                    <p>Plus aucun match programmé dans ce gymnase pour cette phase.</p>
                                {% endif %}
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}

{% block extra_scripts %}
    <script>
        // Filtres du calendrier par gymnase : gymnase choisi + case « Seulement les dates à problème »
        function filterLieu(phaseId) {
            const lieu = document.getElementById('lieuFilter_' + phaseId).value; // id du lieu ou "all"
            const alertesSeules = document.getElementById('alertesSeules_' + phaseId).checked;
            let unVisible = false;

            document.querySelectorAll(`div[data-idphase="${phaseId}"][data-lieu]`).forEach(div => {
                let visible = lieu === 'all' || div.dataset.lieu === lieu;
                if (visible && alertesSeules) visible = div.dataset.aAlerte === '1';
                div.style.display = visible ? '' : 'none';
                unVisible = unVisible || visible;

                // Lignes et cartes sans problème masquées quand la case est cochée
                div.querySelectorAll('[data-alerte]').forEach(el => {
                    el.style.display = alertesSeules && el.dataset.alerte !== '1' ? 'none' : '';
                });
                // Dates passées dépliées si elles contiennent un problème à montrer
                div.querySelectorAll('details[data-passees]').forEach(d => {
                    if (alertesSeules) d.open = !!d.querySelector('[data-alerte="1"]');
                });
            });

            document.getElementById('aucuneAlerte_' + phaseId).classList.toggle('hidden', !(alertesSeules && !unVisible));
        }
    </script>
{% endblock %}
