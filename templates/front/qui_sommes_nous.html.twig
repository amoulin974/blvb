{% extends 'base_front.html.twig' %}

{% block title %}Qui sommes-nous ? - BLVB{% endblock %}

{% block body %}
<div class="container mx-auto max-w-5xl md:px-4 flex flex-col gap-10">
    <h1>Qui sommes-nous ?</h1>

    <section>
        <h2 class="uppercase tracking-wide mb-4">Le championnat comprend</h2>
        {# Clubs et associations : liste tenue à jour dans l'admin (Clubs), chaque nom mène à la fiche du club #}
        <div class="bg-base-100 border border-base-300 rounded-box p-6">
            <h3 class="text-xl uppercase tracking-wide text-(--color-primary) mb-2">Des équipes de clubs et d'associations</h3>
            <ul class="grid gap-x-6 gap-y-1 sm:grid-cols-2">
                {% for club in clubs %}
                    <li><a class="link link-hover link-primary" href="{{ path('front_club_show', {id: club.id}) }}">{{ club.nom }}</a> <span class="text-sm text-(--color-base-content)/70">({{ club.nomCourt|upper }})</span></li>
                {% endfor %}
            </ul>
            <p class="mt-3 text-sm text-(--color-base-content)/80">Des équipes d'entreprises y ont aussi participé (autrefois Quiksilver, Turbomeca…).</p>
            <p class="mt-4"><a href="{{ path('front_club_index') }}" class="btn btn-sm btn-outline btn-primary">Voir les clubs</a></p>
        </div>
    </section>

    <section>
        <h2 class="uppercase tracking-wide mb-4">Ces équipes sont réparties en 4 groupes de niveau</h2>
        <div class="flex flex-col gap-4">
        {% for groupe in groupes %}
            {# Texte et photo côte à côte, alternés d'un groupe à l'autre sur grand écran #}
            <div class="grid gap-0 md:grid-cols-2 bg-base-100 border border-base-300 rounded-box overflow-hidden">
                <div class="p-6 flex flex-col justify-center gap-3 {{ loop.index is even ? 'md:order-last' : '' }}">
                    <h3 class="text-2xl uppercase tracking-wide text-(--color-primary)">{{ groupe.nom }}</h3>
                    <p>{{ groupe.description }}</p>
                    <p><a href="{{ path('front_equipes') }}" class="btn btn-sm btn-outline btn-primary">Voir les équipes</a></p>
                </div>
                <img src="{{ asset('images/'~groupe.image) }}" alt="{{ groupe.nom }}" class="w-full h-full max-h-80 object-cover">
            </div>
        {% endfor %}
        </div>
    </section>
</div>
{% endblock %}
