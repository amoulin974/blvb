{# Dates d'un gymnase (calendrier par gymnase) : tableau (ordinateur) et cartes (mobile).
   Variables : lieu, phase, dates (date "Y-m-d" => liste des matchs, vide pour une date de créneau libre).
   data-alerte="1|0" : utilisé par le filtre « Seulement les dates à problème ». #}
{# --- VUE TABLEAU (ordinateur) --- #}
<div class="hidden md:block">
    <table class="table w-full table-fixed">
        <colgroup>
            <col class="w-[17%]">
            <col class="w-[53%]">
            <col class="w-[30%]">
        </colgroup>
        <thead>
        <tr class="border-b-2 border-(--color-primary) text-xs uppercase tracking-wider text-(--color-base-content)/70">
            <th>Date</th>
            <th>Matchs</th>
            <th>Terrains</th>
        </tr>
        </thead>
        <tbody>
        {% for date, parties in dates %}
            {% set analyse = lieu.analysesByDate[phase.id][date] %}
            {% set alerte = analyse.alerte_horscrenau or analyse.alerte_capacite or analyse.alerte_priorite or analyse.alerte_vacances %}
            <tr data-alerte="{{ alerte ? 1 : 0 }}" class="align-top {{ alerte ? 'bg-(--color-error)/5' : '' }}">
                <td class="font-display text-[17px] font-semibold tracking-wide">{{ date|format_date('full', locale='fr')|capitalize }}</td>
                <td>
                    <ul class="flex flex-col gap-1 text-base">
                        {% for partie in parties %}
                            <li class="rounded px-1 -mx-1" data-recoit="{{ partie.idEquipeRecoit.id }}" data-deplace="{{ partie.idEquipeDeplace.id }}">
                                <span class="font-display font-medium tracking-wide">{{ partie.idEquipeRecoit.nom }}</span>
                                <span class="text-(--color-base-content)/70">contre</span>
                                <span class="font-display font-medium tracking-wide">{{ partie.idEquipeDeplace.nom }}</span>
                                <span class="text-sm text-(--color-base-content)/70 whitespace-nowrap">· {{ partie.poule.nom }}</span>
                            </li>
                        {% else %}
                            <li class="text-(--color-base-content)/70">Aucun match</li>
                        {% endfor %}
                    </ul>
                </td>
                <td>{{ include('front/fragments/_lieu_statut.html.twig', {nbMatchs: parties|length}) }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

{# --- VUE CARTES (mobile) --- #}
<div class="md:hidden flex flex-col gap-2">
    {% for date, parties in dates %}
        {% set analyse = lieu.analysesByDate[phase.id][date] %}
        {% set alerte = analyse.alerte_horscrenau or analyse.alerte_capacite or analyse.alerte_priorite or analyse.alerte_vacances %}
        <div data-alerte="{{ alerte ? 1 : 0 }}" class="card card-xs border border-base-300 {{ alerte ? 'bg-(--color-error)/5' : 'bg-base-100' }}">
            <div class="card-body px-3 py-2 gap-2">
                <h4 class="font-display text-lg font-semibold tracking-wide">{{ date|format_date('full', locale='fr')|capitalize }}</h4>
                <div class="text-base">{{ include('front/fragments/_lieu_statut.html.twig', {nbMatchs: parties|length}) }}</div>
                <ul class="flex flex-col gap-0.5 text-base">
                    {% for partie in parties %}
                        <li class="rounded px-1 -mx-1" data-recoit="{{ partie.idEquipeRecoit.id }}" data-deplace="{{ partie.idEquipeDeplace.id }}">
                            <span class="font-display font-medium tracking-wide">{{ partie.idEquipeRecoit.nom }}</span>
                            <span class="text-(--color-base-content)/70">contre</span>
                            <span class="font-display font-medium tracking-wide">{{ partie.idEquipeDeplace.nom }}</span>
                            <span class="text-sm text-(--color-base-content)/70 whitespace-nowrap">· {{ partie.poule.nom }}</span>
                        </li>
                    {% else %}
                        <li class="text-(--color-base-content)/70">Aucun match</li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    {% endfor %}
</div>
