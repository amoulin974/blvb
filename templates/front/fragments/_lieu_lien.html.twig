{# Lien vers le gymnase sur Google Maps, ou « Gymnase à définir » quand le match ou l'équipe n'a pas (encore) de gymnase.
   Épingle : le lien ouvre une carte (convention « souligné = lien »). Variables : nom, adresse (peuvent être vides). #}
{% import 'admin/_icones.html.twig' as icone %}
{% if nom %}<a class="lien lien-texte" href="https://www.google.com/maps/search/?api=1&query={{ adresse|default(nom)|url_encode }}" target="_blank" rel="noopener noreferrer">{{ icone.i('lieu', 'size-4 inline align-text-bottom mr-0.5') }}{{ nom }}<span class="sr-only"> (carte, nouvel onglet)</span></a>{% else %}<span class="text-(--color-base-content)/70">Gymnase à définir</span>{% endif %}
