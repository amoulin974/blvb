{# Pas de conteneur ici : les pages qui incluent ce fragment (accueil, calendrier) en fournissent déjà un. #}
<div data-controller="score-modal">
    <h1>Calendrier — {{ saison.nom }}</h1>
    {% for phase in saison.phases%}
        <div class="bg-base-100 border-base-300 collapse collapse-arrow md:border">
            <input type="checkbox" {%  if phaseouverte.id==phase.id %}checked {% endif %} class="peer" />
            <div class="collapse-title">
                {{ phase.nom }}
            </div>
            <div class="collapse-content px-0 md:px-4">
                <div class="tabs tabs-lift">
                {% for poule in phase.poules %}

                        <input type="radio" name="tabs_{{phase.id}}" data-poule="{{ poule.id}}" class="tab te" aria-label="{{poule.nom}}" {% if loop.index==1 %}checked {% endif%} />
                        <div class="tab-content bg-[var(--color-base-200)] md:bg-[var(--color-base-100)] border-base-300 p-2 md:p-6">
                        <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                                <label for="equipeFilter_{{ phase.id }}_{{poule.id}}">Filtrer par équipe</label>
                                <select id="equipeFilter_{{ phase.id }}_{{poule.id}}" class="select w-full text-base sm:w-72 md:select-sm md:text-sm" onchange="filterMatches({{phase.id}}, {{poule.id}})">
                                    <option value="all">Toutes les équipes</option>
                                    {% for equipe in poule.equipes %}
                                        <option value="{{equipe.id}}">{{equipe.nom}}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        {% for journee in poule.journees %}

                            <h3 class="{{ loop.first ? 'mt-4' : 'mt-10' }} mb-2">Journée {{ journee.numero }}
                                {% if journee.dateDebut and journee.dateFin %}
                                    <span class="font-normal text-sm">— du {{ journee.dateDebut|format_datetime(pattern='dd/MM/yyyy', locale='fr') }} au {{ journee.dateFin|format_datetime(pattern='dd/MM/yyyy', locale='fr') }}</span>
                                {% endif %}
                            </h3>
                            {% if journee.parties|length >0 %}
                                {# Affichage pour grand écran sous forme de table #}
                                {# table-fixed + colgroup : mêmes largeurs de colonnes pour toutes les journées ;
                                   un nom d'équipe trop long passe sur plusieurs lignes. #}
                                <table class="border border-solid table-xs table-zebra w-full table-fixed hidden md:table" >
                                    <colgroup>
                                        <col class="w-[22%]">
                                        <col class="w-[22%]">
                                        <col class="w-[22%]">
                                        <col class="w-[17%]">
                                        <col class="w-[17%]">
                                    </colgroup>
                                    <tr >
                                        <th>Équipe qui reçoit</th>
                                        <th>Équipe qui se déplace</th>
                                        <th>Date</th>
                                        <th>Lieu</th>
                                        <th>Résultat</th>
                                    </tr>

                                    {% for partie in journee.parties %}
                                        <tr id="tr-partie-{{partie.id}}" data-recoit="{{ partie.idEquipeRecoit.id }}" data-deplace="{{ partie.idEquipeDeplace.id }}">
                                            <td>
                                                <a href="{{path('front_equipe_detail', {'id': partie.idEquipeRecoit.id})}}" title="Voir la fiche de l'équipe" class="link link-hover link-primary focus-visible:underline break-words">{{ partie.idEquipeRecoit.nom }}</a>
                               
                                            </td>
                                            <td class="">
                                            <a href="{{path('front_equipe_detail', {'id': partie.idEquipeDeplace.id})}}" title="Voir la fiche de l'équipe" class="link link-hover link-primary focus-visible:underline break-words">{{ partie.idEquipeDeplace.nom }}</a>
                                   
                                            </td>
                                            <td>{{ partie.date|format_datetime(pattern='EEEE dd/MM/yyyy', locale='fr') }} - {{ partie.date|format_time('short', locale='fr') }}</td>
                                            <td><a class="link link-hover link-primary focus-visible:underline" href="https://www.google.com/maps/search/?api=1&query={{ partie.lieu.adresse|url_encode }}"
                                                target="_blank"
                                                rel="noopener noreferrer">
                                                    {{ partie.lieu.nom }}
                                                </a></td>
                                            <td class="text-base tabular-nums">

                                                {% if partie.getNbSetGagnantReception is not null and partie.getNbSetGagnantDeplacement is not null %}
                                                    <span class="score_partie-{{partie.id}}"><strong>{{ partie.getNbSetGagnantReception }}</strong> - <strong>{{ partie.getNbSetGagnantDeplacement }}</strong></span>
                                                {% else %}
                                                    <span class="score_partie-{{partie.id}}"><span class="opacity-50" title="À venir" aria-hidden="true">–</span><span class="sr-only">À venir</span></span>
                                                {% endif %}
                                                {% if is_granted('ROLE_ADMIN')
                                                            or (app.user is not null
                                                                and partie.idEquipeRecoit.id in (equipesCapitaineIds|default([]))) %}

                                                            <a href="#"
                                                                class="btn btn-warning btn-xs"
                                                                data-action="click->score-modal#openModal"
                                                                data-partie-id="{{ partie.id }}"
                                                                data-equipe-recoit="{{ partie.idEquipeRecoit.nom }}"
                                                                data-equipe-deplace="{{ partie.idEquipeDeplace.nom }}">
                                                                {% if partie.getNbSetGagnantReception != 0 and partie.getNbSetGagnantDeplacement !=0 %}
                                                                    Modifier le résultat
                                                                {% else %}
                                                                    Saisir le résultat
                                                                {% endif  %}
                                                            </a>
                                                            {% endif %}
                                        </tr>

                                    {% endfor %}
                                </table>
                                {# Affichage pour mobile sous forme de carte #}
                                {% for partie in journee.parties %}
                                {# Carte compacte : équipe qui reçoit en haut, équipe qui se déplace en dessous,
                                   score à droite ; date, heure et lieu sur une seule ligne. #}
                                <div class="card bg-base-100 card-xs border border-base-300 block md:hidden liste-equipe-mobile mt-2" id="card-partie-{{partie.id}}" data-recoit="{{ partie.idEquipeRecoit.id }}" data-deplace="{{ partie.idEquipeDeplace.id }}">
                                    <div class="card-body px-3 py-2 gap-1">
                                        <div class="flex items-center gap-3">
                                            <div class="flex-1 min-w-0 text-base leading-snug">
                                                <a href="{{path('front_equipe_detail', {'id': partie.idEquipeRecoit.id })}}" title="Voir la fiche de l'équipe" class="link link-hover link-primary focus-visible:underline font-bold block py-0.5 break-words"><span class="sr-only">Reçoit : </span>{{ partie.idEquipeRecoit.nom }}</a>
                                                <a href="{{path('front_equipe_detail', {'id': partie.idEquipeDeplace.id })}}" title="Voir la fiche de l'équipe" class="link link-hover link-primary focus-visible:underline font-bold block py-0.5 break-words"><span class="sr-only">Se déplace : </span>{{ partie.idEquipeDeplace.nom }}</a>
                                            </div>
                                            <div class="shrink-0 text-right text-base">
                                                {% if partie.getNbSetGagnantReception is not null and partie.getNbSetGagnantDeplacement is not null %}
                                                    <span class="score_partie-{{partie.id}}"><strong>{{ partie.getNbSetGagnantReception }}</strong> - <strong>{{ partie.getNbSetGagnantDeplacement }}</strong></span>
                                                {% else %}
                                                    <span class="score_partie-{{partie.id}}"><span class="opacity-50" title="À venir" aria-hidden="true">–</span><span class="sr-only">À venir</span></span>
                                                {% endif %}
                                            </div>
                                        </div>
                                        <p class="text-sm">
                                            {{ partie.date|format_datetime(pattern='EEE dd/MM', locale='fr') }} · {{ partie.date|format_time('short', locale='fr') }} ·
                                            <a class="link link-hover link-primary focus-visible:underline" href="https://www.google.com/maps/search/?api=1&query={{ partie.lieu.adresse|url_encode }}"
                                                target="_blank"
                                                rel="noopener noreferrer">{{ partie.lieu.nom }}</a>
                                        </p>
                                        {% if is_granted('ROLE_ADMIN')
                                                or (app.user is not null
                                                    and partie.idEquipeRecoit.id in (equipesCapitaineIds|default([]))) %}
                                            <div>
                                                <a href="#"
                                                    class="btn btn-warning btn-xs"
                                                    data-action="click->score-modal#openModal"
                                                    data-partie-id="{{ partie.id }}"
                                                    data-equipe-recoit="{{ partie.idEquipeRecoit.nom }}"
                                                    data-equipe-deplace="{{ partie.idEquipeDeplace.nom }}">
                                                    {% if partie.getNbSetGagnantReception != 0 and partie.getNbSetGagnantDeplacement !=0 %}
                                                        Modifier le résultat
                                                    {% else %}
                                                        Saisir le résultat
                                                    {% endif %}
                                                </a>
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                                {% endfor %}
                            {% else %}
                                <div class="alert alert-info">
                                    Aucun match planifié pour cette journée.
                                </div>
                            {% endif %}
                            {%else%}
                            <div class="alert alert-info">
                                Aucun match planifié pour cette poule.
                            </div>
                        {% endfor %}



                        </div>

                {% endfor %}
                </div>
            </div>
        </div>

    {%  endfor %}

     <div data-score-modal-target="modal" class="modal">
        <div class="modal-box">
            <h3 data-score-modal-target="title" class="font-bold text-lg mb-4">
                Saisir le score
            </h3>

            <div class="mb-2">
                <label data-score-modal-target="labelReception" class="block text-sm font-medium mb-1">Score Équipe 1 :</label>
                <input type="text" data-score-modal-target="inputReception" class="input input-bordered w-full" min="0">
            </div>

            <div class="mb-4">
                <label data-score-modal-target="labelDeplacement" class="block text-sm font-medium mb-1">Score Équipe 2 :</label>
                <input type="text" data-score-modal-target="inputDeplacement" class="input input-bordered w-full" min="0">
            </div>
            <p class="italic text-sm text-gray-500">Saisir 3 et 1 si l'équipe qui reçoit gagne 3 sets à 1.</p>
            <p class="italic text-sm text-gray-500">Si une équipe est forfait saisir un seul F dans son score et rien pour l'autre équipe.</p>
            <div class="modal-action">
                <button class="btn btn-primary" data-action="click->score-modal#submitForm">Valider</button>
                <a href="#" class="btn btn-ghost" data-action="click->score-modal#closeModal">Annuler</a>
            </div>
        </div>
    </div>
</div>

<script>
function filterMatches(phaseId, pouleId) {

    const select = document.getElementById('equipeFilter_' + phaseId + '_' + pouleId);
    const value = select.value;

    // Sélectionner uniquement les tabs de cette poule
    const tabs = document.querySelectorAll('[name="tabs_' + phaseId + '"][data-poule="'+pouleId+'"] + .tab-content table');
    tabs.forEach(tab => {
        const rows = tab.querySelectorAll('tr[data-recoit]');
        rows.forEach(row => {
            const recoit = row.dataset.recoit;
            const deplace = row.dataset.deplace;

            if (value === "all" || recoit === value || deplace === value) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    });

    // Sélectionner uniquement les cartes de cette poule
    const cards = document.querySelectorAll('[name="tabs_' + phaseId + '"][data-poule="'+pouleId+'"] + .tab-content .card');

    cards.forEach(card => {
        const recoit = card.dataset.recoit;
        const deplace = card.dataset.deplace;

        if (value === "all" || recoit === value || deplace === value) {
            card.style.display = '';
        } else {
            card.style.display = 'none';
        }
    });
}
</script>