{# Choix de « Mon équipe » dans une liste (invitation de l'accueil et fenêtre du menu).
   Variable : idSelect (identifiant unique du <select>). Traité par mon_equipe_controller.js#choisir. #}
<div class="flex flex-wrap items-end gap-2" data-mon-equipe-choix>
    <div class="flex flex-col gap-1 grow min-w-56">
        <label for="{{ idSelect }}" class="font-medium">Votre équipe</label>
        <select id="{{ idSelect }}" class="select w-full text-base">
            <option value="">Choisir une équipe…</option>
            {% for equipe in mon_equipe_choix() %}
                <option value="{{ equipe.id }}">{{ equipe.nom }}</option>
            {% endfor %}
        </select>
    </div>
    <button type="button" class="btn btn-accent" data-action="mon-equipe#choisir">C'est mon équipe</button>
</div>
