{# Case « score » d'un match (calendrier : tableau ordinateur et cartes mobiles). Variable : partie.
   - match à venir                 : tiret
   - match passé, score non saisi  : tiret, ou bouton « Saisir » à sa place pour le capitaine qui reçoit / l'admin
   - score saisi                   : score, plus un crayon discret pour le modifier (capitaine qui reçoit / admin)
   Un forfait (-1 set) s'affiche « F » (filtre sets, ScoreExtension), avec le nom de l'équipe forfait pour les lecteurs d'écran.
   La saisie n'est proposée qu'une fois la date du match passée ; un score déjà saisi reste modifiable à tout moment.
   Les boutons transmettent à la fenêtre (score-modal-controller.js) le score actuel (data-score-reception / -deplacement,
   -1 = forfait) et le barème de la saison (data-bareme) pour le résumé des points. Après enregistrement, le contrôleur
   met à jour .score_partie-<id>, ces attributs, et bascule l'affichage entre [data-score-action="saisir"] et [data-score-action="modifier"]. #}
{% set joue = partie.getNbSetGagnantReception is not null and partie.getNbSetGagnantDeplacement is not null %}
{% set passe = partie.date < date() %}
{% set autorise = is_granted('ROLE_ADMIN') or (app.user is not null and partie.idEquipeRecoit.id in (equipesCapitaineIds|default([]))) %}
{% set peutSaisir = autorise and (passe or joue) %}
<span class="inline-flex items-center justify-center gap-1.5">
    <span class="score_partie-{{ partie.id }}{{ (peutSaisir and not joue) ? ' hidden' : '' }}">
        {%- if joue -%}
            <strong>{{ partie.getNbSetGagnantReception|sets }}</strong>–<strong>{{ partie.getNbSetGagnantDeplacement|sets }}</strong>
            {%- if forfait_de(partie) %}<span class="sr-only"> (forfait de {{ forfait_de(partie).nom }})</span>{% endif -%}
        {%- else -%}
            <span class="opacity-50" title="{{ passe ? 'Score non saisi' : 'À venir' }}" aria-hidden="true">–</span><span class="sr-only">{{ passe ? 'Score non saisi' : 'À venir' }}</span>
        {%- endif -%}
    </span>
    {% if peutSaisir %}
        {% set saison = partie.poule.phase.saison %}
        {% set donnees %}
            data-action="click->score-modal#openModal"
            data-partie-id="{{ partie.id }}"
            data-match-passe="{{ passe ? 1 : 0 }}"
            data-equipe-recoit="{{ partie.idEquipeRecoit.nom }}"
            data-equipe-deplace="{{ partie.idEquipeDeplace.nom }}"
            data-score-reception="{{ partie.getNbSetGagnantReception }}"
            data-score-deplacement="{{ partie.getNbSetGagnantDeplacement }}"
            data-bareme="{{ {victoireForte: saison.pointsVictoireForte, victoireFaible: saison.pointsVictoireFaible, defaiteForte: saison.pointsDefaiteForte, defaiteFaible: saison.pointsDefaiteFaible, forfait: saison.pointsForfait}|json_encode }}"
        {% endset %}
        <a href="#"
           class="btn btn-accent btn-sm font-sans{{ joue ? ' hidden' : '' }}"
           data-score-action="saisir"
           aria-label="Saisir le résultat {{ partie.idEquipeRecoit.nom }} contre {{ partie.idEquipeDeplace.nom }}"
           {{ donnees }}>Saisir</a>
        <a href="#"
           class="btn btn-ghost btn-sm btn-square font-sans text-(--color-base-content)/70{{ joue ? '' : ' hidden' }}"
           data-score-action="modifier"
           title="Modifier le résultat"
           aria-label="Modifier le résultat {{ partie.idEquipeRecoit.nom }} contre {{ partie.idEquipeDeplace.nom }}"
           {{ donnees }}>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125"/></svg>
        </a>
    {% endif %}
</span>
