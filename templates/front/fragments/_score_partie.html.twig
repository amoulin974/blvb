{# Case « score » d'un match (accueil, calendrier : tableau ordinateur et cartes mobiles ; admin « Scores à saisir »). Variable : partie.
   - match à venir                 : tiret ; pour ceux qui pourront saisir le score, « Saisie après le match » en dessous
   - match passé, score non saisi  : tiret, ou bouton « Saisir » à sa place pour les capitaines des deux équipes, les responsables du club de l'une ou l'autre équipe, et l'admin
   - score saisi                   : score, plus un crayon discret pour le modifier (mêmes personnes)
   Un forfait (-1 set) s'affiche « F » (filtre sets, ScoreExtension), avec le nom de l'équipe forfait pour les lecteurs d'écran.
   Droits et boutons : _score_boutons.html.twig (aussi utilisé par la fiche équipe). Après enregistrement,
   score-modal-controller.js met à jour .score_partie-<id> et bascule entre [data-score-action="saisir"] et [data-score-action="modifier"]. #}
{% set joue = partie.getNbSetGagnantReception is not null and partie.getNbSetGagnantDeplacement is not null %}
{% set passe = partie.date < date() %}
{# Même règle que App\Service\SaisieScoreService::peutSaisir (droitsSaisie fourni par le contrôleur, SaisieScoreExtension) #}
{% set autorise = score_saisissable(partie, droitsSaisie|default(null)) %}
{% set peutSaisir = autorise and (passe or joue) %}
<span class="inline-flex flex-col items-end lg:items-center">
<span class="inline-flex items-center justify-center gap-1.5">
    <span class="score_partie-{{ partie.id }}{{ (peutSaisir and not joue) ? ' hidden' : '' }}">
        {%- if joue -%}
            <strong>{{ partie.getNbSetGagnantReception|sets }}</strong>–<strong>{{ partie.getNbSetGagnantDeplacement|sets }}</strong>
            {%- if forfait_de(partie) %}<span class="sr-only"> (forfait de {{ forfait_de(partie).nom }})</span>{% endif -%}
        {%- else -%}
            {%- set etat = passe ? 'Score non saisi' : (autorise ? 'Score à saisir après le match' : 'À venir') -%}
            <span class="opacity-50" title="{{ etat }}" aria-hidden="true">–</span><span class="sr-only">{{ etat }}</span>
        {%- endif -%}
    </span>
    {{ include('front/fragments/_score_boutons.html.twig') }}
</span>
{% if autorise and not passe and not joue %}<span class="font-sans font-normal text-xs leading-tight whitespace-normal text-(--color-base-content)/80 text-right lg:text-center" aria-hidden="true">Saisie après le match</span>{% endif %}
</span>
