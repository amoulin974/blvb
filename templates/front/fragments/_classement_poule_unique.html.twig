{# Classement d'une poule (page Classement et fiche équipe).
   Variables : poule ; equipeid (optionnel) = équipe à mettre en évidence.
   Zones de montée / descente : flèche + teinte légère + légende en texte (pas la couleur seule),
   seulement une fois des matchs programmés dans la poule.
   Matchs joués / victoires / défaites : calculés à partir des scores saisis (un forfait est enregistré à -1 set). #}
{% if poule.classements|length > 0 %}
    {% set nbEquipes = poule.classements|length %}
    {% set zonesActives = poule.parties|length > 0 %}

    {# Ordinateur : tableau #}
    <div class="hidden md:block">
        <table class="table w-full table-fixed bg-base-100">
            <colgroup>
                <col class="w-[9%]">
                <col class="w-[43%]">
                <col class="w-[10%]">
                <col class="w-[8%]">
                <col class="w-[8%]">
                <col class="w-[8%]">
                <col class="w-[14%]">
            </colgroup>
            <thead>
                <tr class="border-b-2 border-(--color-primary) text-xs uppercase tracking-wider text-(--color-base-content)/70">
                    <th class="text-center">Rang</th>
                    <th>Équipe</th>
                    <th class="text-center">Points</th>
                    <th class="text-center"><abbr title="Matchs joués" class="no-underline">J</abbr></th>
                    <th class="text-center"><abbr title="Victoires" class="no-underline">V</abbr></th>
                    <th class="text-center"><abbr title="Défaites" class="no-underline">D</abbr></th>
                    <th class="text-center">Sets</th>
                </tr>
            </thead>
            <tbody>
            {% for classement in poule.classements %}
                {% set montee = zonesActives and classement.position <= poule.NbMonteeDefaut %}
                {% set descente = zonesActives and classement.position > (nbEquipes - poule.NbDescenteDefaut) %}
                {% set courante = equipeid is defined and classement.equipe.id == equipeid %}
                {% set matchsJoues = poule.parties|filter(p => (p.idEquipeRecoit.id == classement.equipe.id or p.idEquipeDeplace.id == classement.equipe.id) and p.nbSetGagnantReception is not null and p.nbSetGagnantDeplacement is not null) %}
                {% set joues = matchsJoues|length %}
                {% set victoires = matchsJoues|filter(p => p.idEquipeRecoit.id == classement.equipe.id ? p.nbSetGagnantReception > p.nbSetGagnantDeplacement : p.nbSetGagnantDeplacement > p.nbSetGagnantReception)|length %}
                <tr data-equipe="{{ classement.equipe.id }}" class="align-top {{ courante ? 'bg-(--color-base-200)' : (montee ? 'bg-(--color-success)/10' : (descente ? 'bg-(--color-warning)/10' : '')) }}">
                    <td class="text-center font-display text-2xl font-extrabold text-(--color-primary) tabular-nums whitespace-nowrap">
                        {{ classement.position }}
                        {% if montee %}<span class="text-sm text-(--color-success)" title="Zone de montée" aria-hidden="true">▲</span><span class="sr-only">(zone de montée)</span>{% endif %}
                        {% if descente %}<span class="text-sm text-(--color-warning)" title="Zone de descente" aria-hidden="true">▼</span><span class="sr-only">(zone de descente)</span>{% endif %}
                    </td>
                    <td>
                        <a href="{{ path('front_equipe_detail', {'id': classement.equipe.id}) }}" title="Voir la fiche de l'équipe" class="link link-hover link-primary focus-visible:underline break-words font-display text-[17px] tracking-wide {{ courante ? 'font-extrabold' : 'font-medium' }}">{{ classement.equipe.nom }}</a>
                        {{ include('front/fragments/_classement_detail_matchs.html.twig') }}
                    </td>
                    <td class="text-center font-display text-xl font-bold tabular-nums">{{ classement.points }}</td>
                    <td class="text-center tabular-nums">{{ joues }}</td>
                    <td class="text-center tabular-nums">{{ victoires }}</td>
                    <td class="text-center tabular-nums">{{ joues - victoires }}</td>
                    <td class="text-center tabular-nums whitespace-nowrap">{{ classement.setGagnes }}–{{ classement.setPerdus }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    {# Mobile : cartes compactes, rang à gauche, points à droite #}
    <div class="md:hidden flex flex-col gap-2">
        {% for classement in poule.classements %}
            {% set montee = zonesActives and classement.position <= poule.NbMonteeDefaut %}
            {% set descente = zonesActives and classement.position > (nbEquipes - poule.NbDescenteDefaut) %}
            {% set courante = equipeid is defined and classement.equipe.id == equipeid %}
            {% set matchsJoues = poule.parties|filter(p => (p.idEquipeRecoit.id == classement.equipe.id or p.idEquipeDeplace.id == classement.equipe.id) and p.nbSetGagnantReception is not null and p.nbSetGagnantDeplacement is not null) %}
            {% set joues = matchsJoues|length %}
            {% set victoires = matchsJoues|filter(p => p.idEquipeRecoit.id == classement.equipe.id ? p.nbSetGagnantReception > p.nbSetGagnantDeplacement : p.nbSetGagnantDeplacement > p.nbSetGagnantReception)|length %}
            <div data-equipe="{{ classement.equipe.id }}" class="card card-xs border border-base-300 {{ courante ? 'bg-(--color-base-200)' : (montee ? 'bg-(--color-success)/10' : (descente ? 'bg-(--color-warning)/10' : 'bg-base-100')) }}">
                <div class="card-body px-3 py-2 gap-1">
                    <div class="flex items-center gap-3">
                        <div class="shrink-0 w-10 text-center font-display text-2xl font-extrabold text-(--color-primary) tabular-nums leading-none">
                            {{ classement.position }}
                            {% if montee %}<div class="text-xs text-(--color-success)" aria-hidden="true">▲</div><span class="sr-only">(zone de montée)</span>{% endif %}
                            {% if descente %}<div class="text-xs text-(--color-warning)" aria-hidden="true">▼</div><span class="sr-only">(zone de descente)</span>{% endif %}
                        </div>
                        <div class="flex-1 min-w-0">
                            <a href="{{ path('front_equipe_detail', {'id': classement.equipe.id}) }}" title="Voir la fiche de l'équipe" class="link link-hover link-primary focus-visible:underline block py-0.5 break-words font-display text-lg tracking-wide {{ courante ? 'font-extrabold' : 'font-medium' }}">{{ classement.equipe.nom }}</a>
                            <p class="text-sm">{{ joues }} joué{{ joues > 1 ? 's' : '' }} · {{ victoires }} V · {{ joues - victoires }} D · sets {{ classement.setGagnes }}–{{ classement.setPerdus }}</p>
                        </div>
                        <div class="shrink-0 text-right">
                            <span class="font-display text-2xl font-bold tabular-nums">{{ classement.points }}</span>
                            <span class="text-sm">{{ classement.points > 1 ? 'pts' : 'pt' }}</span>
                        </div>
                    </div>
                    {{ include('front/fragments/_classement_detail_matchs.html.twig') }}
                </div>
            </div>
        {% endfor %}
    </div>

    {% if zonesActives and (poule.NbMonteeDefaut > 0 or poule.NbDescenteDefaut > 0) %}
        <p class="mt-3 text-sm flex flex-wrap gap-x-4 gap-y-1">
            {% if poule.NbMonteeDefaut > 0 %}<span><span class="text-(--color-success)" aria-hidden="true">▲</span> Zone de montée</span>{% endif %}
            {% if poule.NbDescenteDefaut > 0 %}<span><span class="text-(--color-warning)" aria-hidden="true">▼</span> Zone de descente</span>{% endif %}
        </p>
    {% endif %}
{% else %}
    <p class="alert alert-info">Aucun résultat saisi</p>
{% endif %}
