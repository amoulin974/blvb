{% extends 'base_front.html.twig' %}

{% block title %}Les équipes — {{ saison.nom }} - BLVB{% endblock %}

{% block body %}
<div class="container mx-auto max-w-5xl md:px-4">
    <h1>Les équipes — {{ saison.nom }}</h1>
    {% for phase in saison.phases%}
        <div class="bg-base-100 border-base-300 collapse {%  if phaseouverte.id==phase.id %}collapse-open {% endif %}collapse-arrow md:border">
            <input type="checkbox" class="peer" />
            <div class="collapse-title font-display text-xl font-semibold">
                {{ phase.nom }}
            </div>
            <div class="collapse-content px-0 md:px-4">
                <div class="tabs tabs-lift">
                {% for poule in phase.poules %}

                        <input type="radio" name="tabs_{{phase.id}}" data-equipes="{{ poule.equipes|map(e => e.id)|join(' ') }}" class="tab te" aria-label="{{poule.nom}}" {% if loop.index==1 %}checked {% endif%} />
                        <div class="tab-content bg-[var(--color-base-200)] md:bg-[var(--color-base-100)] border-base-300 p-2 md:p-6">
                        {% if poule.equipes|length ==0 %}
                            <p class="alert alert-info">Aucune équipe dans cette poule.</p>
                        {% else %}
                        {# Tri de la poule (tri_equipes_controller.js) : par nom (défaut) ou par classement, au clic sur l'en-tête
                           (ordinateur) ou sur les boutons « Trier » (mobile). Validé par l'ergonome. #}
                        <div data-controller="tri-equipes">
                        {# Affichage pour grand écran sous forme de table (même style que le calendrier) #}
                            <div class="hidden md:block">
                                <table class="table w-full table-fixed bg-base-100">
                                    <colgroup>
                                        <col class="w-[32%]">
                                        <col class="w-[26%]">
                                        <col class="w-[27%]">
                                        <col class="w-[15%]">
                                    </colgroup>
                                    <thead>
                                        <tr class="border-b-2 border-(--color-primary) text-xs uppercase tracking-wider text-(--color-base-content)/70">
                                            <th aria-sort="ascending" data-tri-equipes-target="entete" data-cle="nom">
                                                <button type="button" class="inline-flex items-center gap-1 uppercase tracking-wider font-semibold cursor-pointer hover:text-(--color-primary) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-primary) rounded" data-action="tri-equipes#trier" data-tri-equipes-cle-param="nom">Équipe <span aria-hidden="true" data-tri-equipes-target="fleche" data-cle="nom">▲</span></button>
                                            </th>
                                            <th>Gymnase</th>
                                            <th>Réception habituelle</th>
                                            <th class="text-right" data-tri-equipes-target="entete" data-cle="classement">
                                                <button type="button" class="inline-flex items-center gap-1 uppercase tracking-wider font-semibold cursor-pointer hover:text-(--color-primary) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-primary) rounded" data-action="tri-equipes#trier" data-tri-equipes-cle-param="classement">Classement <span aria-hidden="true" class="opacity-40" data-tri-equipes-target="fleche" data-cle="classement">⇅</span></button>
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody data-tri-equipes-target="liste">
                                    {% for equipe in poule.equipes|sort((a, b) => a.nomSansClub|lower <=> b.nomSansClub|lower) %}
                                        {% set position = null %}
                                        {% for classement in equipe.classements %}{% if classement.poule == poule %}{% set position = classement.position %}{% endif %}{% endfor %}
                                        <tr class="hover:bg-(--color-base-200)" data-equipe="{{ equipe.id }}" data-tri-nom="{{ equipe.nomSansClub|lower }}" data-tri-classement="{{ position }}">
                                            <td>
                                                <a href="{{path('front_equipe_detail', {'id': equipe.id})}}" title="Voir la fiche de l'équipe" class="link link-hover link-primary focus-visible:underline break-words font-display font-medium text-[17px] tracking-wide">{{ equipe.nomSimple }}</a>
                                                {{ include('front/fragments/_sigle_club.html.twig') }}
                                            </td>
                                            <td>
                                                {{ include('front/fragments/_lieu_lien.html.twig', {nom: equipe.lieu ? equipe.lieu.nom : null, adresse: equipe.lieu ? equipe.lieu.adresse : null}) }}
                                            </td>
                                            <td>
                                                {% for creneau in (equipe.lieu ? equipe.lieu.creneaux : []) %}
                                                    <div>{{ creneau.jourLibelle }} · {{ creneau.heureDebut|format_time('short', locale='fr') }}</div>
                                                {% else %}
                                                    <span class="text-(--color-base-content)/70">Non défini</span>
                                                {% endfor %}
                                            </td>
                                            <td class="text-right font-display text-xl font-extrabold text-(--color-primary) tabular-nums">
                                                {% if position is not null %}{{ position }}{% else %}<span class="opacity-50" aria-hidden="true">–</span><span class="sr-only">Non classé</span>{% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                            {# Affichage pour mobile : cartes compactes, nom et classement en haut, gymnase et créneau dessous #}
                            <div class="md:hidden flex flex-col gap-2">
                                {# Tri des cartes : pas d'en-tête sur mobile, deux boutons à la place #}
                                <div class="flex items-center gap-2 text-sm" role="group" aria-label="Trier les équipes">
                                    <span>Trier :</span>
                                    <button type="button" class="btn btn-sm min-h-11 btn-primary" aria-pressed="true" data-tri-equipes-target="bouton" data-cle="nom" data-action="tri-equipes#trier" data-tri-equipes-cle-param="nom">Nom</button>
                                    <button type="button" class="btn btn-sm min-h-11 btn-ghost" aria-pressed="false" data-tri-equipes-target="bouton" data-cle="classement" data-action="tri-equipes#trier" data-tri-equipes-cle-param="classement">Classement</button>
                                </div>
                                <div class="flex flex-col gap-2" data-tri-equipes-target="liste">
                                {% for equipe in poule.equipes|sort((a, b) => a.nomSansClub|lower <=> b.nomSansClub|lower) %}
                                    {% set position = null %}
                                    {% for classement in equipe.classements %}{% if classement.poule == poule %}{% set position = classement.position %}{% endif %}{% endfor %}
                                    <div class="card card-xs bg-base-100 border border-base-300" data-equipe="{{ equipe.id }}" data-tri-nom="{{ equipe.nomSansClub|lower }}" data-tri-classement="{{ position }}">
                                        <div class="card-body px-3 py-2 gap-1">
                                            <div class="flex items-center gap-3">
                                                {# Nom de l'équipe et abréviation du club (lien vers la fiche du club) #}
                                                <span class="flex-1 min-w-0 flex flex-wrap items-baseline gap-x-2">
                                                    <a href="{{path('front_equipe_detail', {'id': equipe.id})}}" title="Voir la fiche de l'équipe" class="min-w-0 link link-hover link-primary focus-visible:underline font-display font-medium text-lg tracking-wide py-0.5 break-words">{{ equipe.nomSimple }}</a>
                                                    {{ include('front/fragments/_sigle_club.html.twig') }}
                                                </span>
                                                {% if position is not null %}
                                                    <span class="shrink-0 font-display text-2xl font-extrabold text-(--color-primary) tabular-nums"><span class="sr-only">Classement : </span>{{ position }}<sup class="text-sm">{{ position == 1 ? 'er' : 'e' }}</sup></span>
                                                {% endif %}
                                            </div>
                                            <p class="text-sm">
                                                {{ include('front/fragments/_lieu_lien.html.twig', {nom: equipe.lieu ? equipe.lieu.nom : null, adresse: equipe.lieu ? equipe.lieu.adresse : null}) }}
                                                {% for creneau in (equipe.lieu ? equipe.lieu.creneaux : []) %} · {{ creneau.jourLibelle }} {{ creneau.heureDebut|format_time('short', locale='fr') }}{% endfor %}
                                            </p>
                                        </div>
                                    </div>
                                {% endfor %}
                                </div>
                            </div>
                        </div>
                        {% endif %}
                        </div>

                {% endfor %}
                </div>
            </div>
        </div>
    {%  endfor %}
    </div>
{% endblock %}
