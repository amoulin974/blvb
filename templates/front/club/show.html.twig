{% extends "base_front.html.twig" %}
{% block title %}{{ club.nom }} - Site du BLVB{% endblock %}

{% block body %}
    <div class="container mx-auto max-w-5xl md:px-4 flex flex-col gap-6">
        {% for message in app.flashes('success') %}
            <div role="status" class="alert alert-success">{{ message }}</div>
        {% endfor %}

        {# En-tête : nom long, abréviation, lien ; bouton de modification pour les responsables et l'admin #}
        <div>
            <a class="link link-hover text-sm" href="{{ path('front_club_index') }}">← Tous les clubs</a>
            <div class="mt-2 flex flex-wrap items-center justify-between gap-3">
                <div class="flex items-center gap-4">
                    {{ include('front/club/_logo.html.twig', {club: club, taille: 'size-20 md:size-24'}) }}
                    <h1 class="text-3xl md:text-4xl uppercase tracking-wide">{{ club.nom }}</h1>
                </div>
                {% if is_granted('CLUB_MODIFIER', club) %}
                    <a class="btn btn-outline btn-primary md:btn-sm" href="{{ path('front_club_edit', {id: club.id}) }}">Modifier la fiche du club</a>
                {% endif %}
            </div>
            <p class="mt-1"><span class="badge badge-outline" title="Abréviation, affichée après le nom des équipes">{{ club.nomCourt|upper }}</span></p>
            {% if club.url %}
                <p class="mt-2"><a class="link link-primary break-all" href="{{ club.url }}" target="_blank" rel="noopener noreferrer">{{ club.url }}</a></p>
            {% endif %}
        </div>

        {% if club.description %}
            <section aria-labelledby="titre-presentation" class="bg-base-100 border border-base-300 rounded-box p-4 md:p-6">
                <h2 id="titre-presentation" class="text-xl uppercase tracking-wide">Présentation</h2>
                <p class="mt-2 whitespace-pre-line">{{ club.description }}</p>
            </section>
        {% endif %}

        <div class="grid gap-6 md:grid-cols-2">
            <section aria-labelledby="titre-equipes" class="bg-base-100 border border-base-300 rounded-box p-4 md:p-6">
                <h2 id="titre-equipes" class="text-xl uppercase tracking-wide">Équipes{% if saison %} <span class="text-base normal-case tracking-normal text-(--color-base-content)/70">· {{ saison.nom }}</span>{% endif %}</h2>
                {# Équipes engagées dans la saison en cours, avec leur poule #}
                <ul class="mt-2 space-y-2">
                    {% for ligne in equipesEngagees %}
                        <li class="flex flex-wrap items-baseline justify-between gap-x-3">
                            <a class="link link-hover link-primary font-semibold" href="{{ path('front_equipe_detail', {id: ligne.equipe.id}) }}">{{ ligne.equipe.nom }}</a>
                            <span class="text-sm text-(--color-base-content)/80">{{ ligne.poules|join(' · ') }}</span>
                        </li>
                    {% else %}
                        <li class="text-(--color-base-content)/70">Aucune équipe engagée cette saison.</li>
                    {% endfor %}
                </ul>
            </section>
            <section aria-labelledby="titre-gymnases" class="bg-base-100 border border-base-300 rounded-box p-4 md:p-6">
                <h2 id="titre-gymnases" class="text-xl uppercase tracking-wide">Gymnases</h2>
                <ul class="mt-2 space-y-1">
                    {% for lieu in club.lieux %}
                        <li>{{ include('front/fragments/_lieu_lien.html.twig', {nom: lieu.nom, adresse: lieu.adresse}) }}{% if lieu.adresse %} <span class="text-sm text-(--color-base-content)/70">· {{ lieu.adresse }}</span>{% endif %}</li>
                    {% else %}
                        <li class="text-(--color-base-content)/70">Aucun gymnase renseigné.</li>
                    {% endfor %}
                </ul>
            </section>
        </div>
    </div>
{% endblock %}
