{%  extends 'base_front.html.twig' %}
{# Règlement de la saison affichée (docs/wizard-saison/decisions.md, D55 à D58) : texte des admins, déjà nettoyé, avec
   ses éléments calculés (App\Reglement\RenduReglement) ; sommaire tocbot sur les h2 et h3 (assets/controllers/tocbotController.js). #}
{% block title %}Règlement — {{ saison.nom }} - BLVB{% endblock %}

{% block body %}
<div class="container mx-auto max-w-7xl md:px-4"{% if contenu %} data-controller="tocbot"{% endif %}>

    <div class="grid grid-cols-8 gap-4 print:block">
        {% if contenu %}
            <nav aria-label="Sommaire du règlement" class="col-span-8 lg:col-span-2 lg:sticky lg:top-20 lg:max-h-[calc(100vh-6rem)] overflow-y-auto print:hidden">
                <div class="mb-2 lg:hidden">
                    <button id="toc-toggle" type="button" class="btn btn-outline btn-primary min-h-11" aria-expanded="false" aria-controls="toc">
                        Sommaire
                    </button>
                </div>
                <div id="toc" class="toc js-toc hidden lg:block bg-base-100 border border-base-300 rounded-box p-4"></div>
            </nav>
        {% endif %}
        <article id="article-reglement" class="js-toc-content col-span-8 {{ contenu ? 'lg:col-span-6 lg:col-start-3' : 'lg:col-span-6 lg:col-start-2' }} bg-base-100 border border-base-300 rounded-box p-4 md:p-8 print:border-0 print:p-0">
            <h1>Règlement de la saison {{ saison.nom|replace({'Saison ': ''}) }}</h1>
            {% if contenu %}
                {% if reglement.modifieLe %}
                    {% set jour = reglement.modifieLe|date('j') %}
                    <p class="reglement-bloc-infos">Mis à jour le <time datetime="{{ reglement.modifieLe|date('Y-m-d') }}">{{ jour == '1' ? '1er' : jour }} {{ reglement.modifieLe|format_datetime(pattern: 'MMMM yyyy', locale: 'fr') }}</time></p>
                {% endif %}
                {% if not saison.favori %}
                    <p class="reglement-bloc-infos">Ce règlement n'est pas celui de la saison en cours. Changez de saison dans le menu.</p>
                {% endif %}
                {{ contenu|raw }}
            {% else %}
                <p>Le règlement de cette saison n'est pas encore publié.</p>
                <p class="reglement-bloc-infos">Les règlements des autres saisons sont accessibles en changeant de saison dans le menu.</p>
            {% endif %}
        </article>
    </div>
</div>
{% endblock %}
